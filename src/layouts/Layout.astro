---
import '../styles/global.css';
import Analytics from '@vercel/analytics/astro';
import SpeedInsights from '@vercel/speed-insights/astro';
import { SITE, absoluteUrl } from '../lib/site';
import { organizationSchema } from '../lib/seo';

interface Props {
  title: string;
  description: string;
  canonical: string;
  ogImage?: string;
  schema?: object | object[];
  noIndex?: boolean;
}
const { title, description, canonical, ogImage = SITE.ogImage, schema, noIndex } = Astro.props;
const resolvedOgImage = ogImage.startsWith('http') ? ogImage : absoluteUrl(ogImage);
const schemaNodes = [organizationSchema(), ...(Array.isArray(schema) ? schema : schema ? [schema] : [])];
---

<!doctype html>
<html lang="en" class="">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ec4899" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <title>{title}</title>
    <meta name="description" content={description.slice(0, 160)} />
    <link rel="canonical" href={canonical} />

    <meta property="og:title" content={title} />
    <meta property="og:description" content={description.slice(0, 160)} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="en_US" />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description.slice(0, 160)} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <meta
      name="robots"
      content={noIndex ? 'noindex, nofollow' : 'index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1'}
    />
    {schemaNodes.map((node) => (
      <script is:inline type="application/ld+json" set:html={JSON.stringify(node)} />
    ))}

    <script is:inline>
      /* Light mode only — clear any stale dark preference */
      try {
        ['cc-theme','cc-theme-v2','theme','color-theme','dark-mode'].forEach(function(k){
          localStorage.removeItem(k);
        });
      } catch(e){}
      document.documentElement.classList.remove('dark');
    </script>
    <slot name="head" />
  </head>

  <body class="min-h-screen bg-[var(--color-bg)] text-[var(--color-text)] antialiased">
    <a href="#main-content" class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:rounded-md focus:bg-pink-600 focus:px-4 focus:py-2 focus:text-white">
      Skip to content
    </a>

    <slot />

    <div id="cursor-glow" aria-hidden="true"></div>

    <script is:inline>
      (function(){
        var glow=document.getElementById('cursor-glow');
        var touch=window.matchMedia('(pointer: coarse)').matches;
        var reduced=window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if(glow&&!touch&&!reduced){
          var gx=0,gy=0,cx=0,cy=0;
          glow.style.opacity='1';
          document.addEventListener('mousemove',function(e){cx=e.clientX;cy=e.clientY;});
          (function loop(){gx+=(cx-gx)*0.08;gy+=(cy-gy)*0.08;
            glow.style.left=gx+'px';glow.style.top=gy+'px';requestAnimationFrame(loop);})();
        }
        document.addEventListener('click',function(e){
          var t=e.target.closest('a[href],button');
          if(!t||reduced)return;
          var r=t.getBoundingClientRect();
          var rp=document.createElement('span');
          rp.className='ripple-effect';
          rp.style.left=(e.clientX-r.left)+'px';rp.style.top=(e.clientY-r.top)+'px';
          if(getComputedStyle(t).position==='static')t.style.position='relative';
          t.style.overflow='hidden';t.appendChild(rp);
          setTimeout(function(){if(rp.parentNode)rp.parentNode.removeChild(rp);},700);
        });
      })();
    </script>

    <script is:inline>
      (function(){
        if(typeof IntersectionObserver==='undefined')return;
        var obs=new IntersectionObserver(function(entries){
          entries.forEach(function(e){if(e.isIntersecting){e.target.classList.add('scroll-visible');obs.unobserve(e.target);}});
        },{threshold:0.1,rootMargin:'0px 0px -40px 0px'});
        function observe(){document.querySelectorAll('[data-scroll]').forEach(function(el){obs.observe(el);});}
        if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',observe);else observe();
      })();
    </script>

    {import.meta.env.PROD && <Analytics />}
    {import.meta.env.PROD && <SpeedInsights />}
  </body>
</html>
