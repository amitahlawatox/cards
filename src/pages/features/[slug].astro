---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { PHOTO_FOCUSED_OCCASIONS, getOccasionBySlug, getOccasionsBySlugs, getProductFeatureStaticPaths } from '../../lib/content';
import type { Occasion } from '../../lib/occasions';
import { SITE, absoluteUrl } from '../../lib/site';
import { articleSchema, breadcrumbSchema, faqSchema } from '../../lib/seo';

export function getStaticPaths() {
  return getProductFeatureStaticPaths();
}

const { feature } = Astro.props;
const occasions = getOccasionsBySlugs(feature.occasionSlugs);
const path = `/features/${feature.slug}/`;
const isPhotoFeature = feature.slug === 'photo-card-maker';
const photoOccasions = isPhotoFeature ? PHOTO_FOCUSED_OCCASIONS.map((slug) => getOccasionBySlug(slug)).filter((occasion): occasion is Occasion => Boolean(occasion)) : [];
const bestFitNames = occasions.map((occasion) => occasion.name).join(', ');
const featureCapabilities: Record<string, Array<{ title: string; description: string }>> = {
  'online-card-maker': [
    { title: 'Fast editor flow', description: 'Open an occasion-specific editor instead of starting from a blank generic design tool.' },
    { title: 'Share or print', description: 'Move from draft to PNG, PDF, hosted invite page, or WhatsApp-friendly sharing without switching products.' },
    { title: 'Invitation-first help', description: 'Use built-in wording, hosted pages, and occasion routes that are built around real invitation tasks.' },
  ],
  'photo-card-maker': [
    { title: 'Photo-ready layouts', description: 'Use templates that leave enough room for a strong image plus the event details guests actually need.' },
    { title: 'Quick image upload', description: 'Add a family, baby, graduation, or couple photo inside the editor without leaving the creation flow.' },
    { title: 'Dual output', description: 'Turn one design into both a mobile share card and a print-ready export for later use.' },
  ],
  'printable-invitation-maker': [
    { title: 'Print-ready export', description: 'Create a digital invitation and still leave with a clean PDF or high-resolution PNG for home printing.' },
    { title: 'Clear detail hierarchy', description: 'Keep names, time, venue, and RSVP readable so a printed card still works without follow-up messages.' },
    { title: 'Fast turnaround', description: 'Ideal for hosts who need something polished today, not a long approval or print ordering cycle.' },
  ],
  'whatsapp-invitation-maker': [
    { title: 'Mobile-first sharing', description: 'Build invitations that read clearly on phones, then share them by link, image, or message in minutes.' },
    { title: 'Family event speed', description: 'Useful for festive gatherings, housewarmings, baby showers, and last-minute parties where WhatsApp is the default channel.' },
    { title: 'Hosted detail backup', description: 'Pair the image card with a hosted invite page when schedule, dress code, or RSVP details need more space.' },
  ],
  'rsvp-invitation-pages': [
    { title: 'Hosted invite utility', description: 'Add maps, calendar actions, structured RSVP replies, guest questions, and host notes to one shareable page.' },
    { title: 'Guest planning prompts', description: 'Collect practical details like headcount, meal preference, potluck items, or simple event questions without a backend form.' },
    { title: 'Better host control', description: 'Keep the invitation card clean while moving longer notes, reminders, and follow-up details onto the hosted page.' },
  ],
};
const featureFaqs: Record<string, Array<{ question: string; answer: string }>> = {
  'online-card-maker': [
    { question: 'Can I use this online card maker for invitations specifically?', answer: 'Yes. The route is built for invitation use cases first, including wording, occasion pages, downloads, and hosted invite support.' },
    { question: 'Do I need an account to make a card online?', answer: 'No. You can open the editor, customize the card, and export it without creating an account.' },
    { question: 'Can I switch from a digital card to a printable version later?', answer: 'Yes. The same design can be adapted for image sharing, PDF export, or a hosted invite page.' },
  ],
  'photo-card-maker': [
    { question: 'What types of events work best with a photo card?', answer: 'Photo cards work especially well for birthdays, baby showers, anniversaries, graduations, and family events where recognition or emotion matters.' },
    { question: 'Can I upload my own image?', answer: 'Yes. The editor supports image uploads so you can personalize the invitation with your own picture.' },
    { question: 'Can I still print a photo invitation?', answer: 'Yes. You can use the finished design for digital sharing or export it for print workflows.' },
  ],
  'printable-invitation-maker': [
    { question: 'Can I print these invitations at home?', answer: 'Yes. The printable route is built for high-resolution output that works for home or local print use.' },
    { question: 'Do printable cards still work for digital sharing?', answer: 'Yes. Many hosts create one version for print and another for mobile sharing from the same editor workflow.' },
    { question: 'What details matter most on a printable invite?', answer: 'A printable invitation should make the event title, date, time, venue, and RSVP information easy to scan quickly.' },
  ],
  'whatsapp-invitation-maker': [
    { question: 'Can I send the invite directly on WhatsApp?', answer: 'You can create the card, copy the hosted link if needed, and send the result through WhatsApp or any other mobile messaging app.' },
    { question: 'Why use a hosted page with a WhatsApp invite?', answer: 'A hosted page gives you more room for RSVP timing, dress code, schedule details, and map or calendar actions than the card image alone.' },
    { question: 'Is this only for festive events?', answer: 'No. It is useful for birthdays, showers, housewarmings, family gatherings, and any event where mobile sharing is the fastest path.' },
  ],
  'rsvp-invitation-pages': [
    { question: 'What can a hosted RSVP page include?', answer: 'A hosted page can carry event timing, venue details, dress code, schedule notes, guest questions, simple contribution prompts, and RSVP actions.' },
    { question: 'Do guests need an account to reply?', answer: 'No. Guests can use the structured RSVP summary and send their response by email, WhatsApp, or manual copy without signing in.' },
    { question: 'Why are hosted invite pages private by default?', answer: 'They may contain personal event details, so they are designed to be shared directly with guests after a card is created.' },
  ],
};
const capabilities = featureCapabilities[feature.slug] ?? [];
const faqs = featureFaqs[feature.slug] ?? [];
const schema = [
  articleSchema({ title: `${feature.title} | ${SITE.name}`, description: feature.description, path }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Features', path: '/features/' },
    { name: feature.title, path },
  ]),
  ...(faqs.length > 0 ? [faqSchema(faqs)] : []),
];
---

<Layout title={`${feature.title} | ${SITE.name}`} description={feature.description} canonical={absoluteUrl(path)} schema={schema}>
  <Header />
  <main id="main-content" class="mx-auto max-w-7xl px-6 py-12">
    <div class="rounded-[2rem] border px-8 py-10" style="background:linear-gradient(135deg,#fff7f0,#eef2ff);border-color:#DDD6FE;">
      <p class="text-sm font-bold uppercase tracking-[0.24em]" style="color:#ea580c;">Product page</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight" style="color:#1A1340;">{feature.title}</h1>
      <p class="mt-4 max-w-4xl text-lg leading-relaxed" style="color:#6B63A3;">{feature.intro}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={feature.ctaPath} class="rounded-full px-5 py-3 text-sm font-bold text-white" style="background:linear-gradient(135deg,#4F46E5,#7C3AED);">
          {feature.ctaLabel}
        </a>
        <a href="/features/" class="rounded-full px-5 py-3 text-sm font-bold" style="background:var(--color-surface);color:var(--color-text);border:1px solid var(--color-border);">
          View all features
        </a>
      </div>
    </div>

    <section class="mt-10 grid gap-5 md:grid-cols-3" data-scroll>
      {feature.highlights.map((highlight, index) => (
        <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
          <p class="text-xs font-bold uppercase tracking-[0.22em]" style="color:#ea580c;">Benefit {index + 1}</p>
          <p class="mt-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">{highlight}</p>
        </div>
      ))}
    </section>

    <section class="mx-auto py-10" data-scroll>
      <h2 class="mb-5 text-2xl font-black tracking-tight" style="color:var(--color-text);">What this feature helps you do</h2>
      <div class="flex flex-wrap gap-3">
        {feature.queryFocus.map((query) => (
          <span class="rounded-full border px-4 py-2 text-sm font-semibold" style="background:var(--color-surface);border-color:var(--color-border);color:var(--color-text-muted);">
            {query}
          </span>
        ))}
      </div>
    </section>

    {capabilities.length > 0 && (
      <section class="mx-auto py-10" data-scroll>
        <h2 class="mb-5 text-2xl font-black tracking-tight" style="color:var(--color-text);">What this feature helps a host do</h2>
        <div class="grid gap-4 md:grid-cols-3">
          {capabilities.map((item) => (
            <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
              <h3 class="text-lg font-black" style="color:var(--color-text);">{item.title}</h3>
              <p class="mt-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">{item.description}</p>
            </div>
          ))}
        </div>
      </section>
    )}

    <section class="mx-auto py-10" data-scroll>
      <h2 class="mb-5 text-2xl font-black tracking-tight" style="color:var(--color-text);">Best invitation journeys for this feature</h2>
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        {occasions.map((occasion) => (
          <a href={`/make/${occasion.slug}/`} class="rounded-3xl border p-6 transition-all hover:-translate-y-1" style="background:var(--color-surface);border-color:var(--color-border);">
            <p class="text-3xl">{occasion.emoji}</p>
            <h3 class="mt-4 text-lg font-black" style="color:var(--color-text);">{occasion.name}</h3>
            <p class="mt-2 text-sm leading-relaxed" style="color:var(--color-text-muted);">{occasion.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="mx-auto py-10" data-scroll>
      <div class="grid gap-6 lg:grid-cols-[1fr_1fr]">
        <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
          <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">How this feature helps a real user task</h2>
          <p class="mt-4 text-sm leading-relaxed" style="color:var(--color-text-muted);">
            People landing on this page usually know the format they want before they know the occasion route they should open. That is why this feature page exists: it translates broad product intent into a smaller set of invitation flows that are actually ready to use.
          </p>
          <p class="mt-4 text-sm leading-relaxed" style="color:var(--color-text-muted);">
            The best fits here are {bestFitNames.toLowerCase()}. Those routes already have stronger template context, cleaner wording hand-off, and a faster path from browsing to a finished design.
          </p>
        </div>

        <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
          <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">What to do after opening the editor</h2>
          <ul class="mt-4 space-y-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">
            <li>Pick the occasion route closest to the event instead of editing from a generic blank state.</li>
            <li>Finish the event title, date, venue, and RSVP details before changing visual details.</li>
            <li>Choose the delivery format early: printable PDF, PNG, hosted invite page, or mobile-first sharing.</li>
            <li>Use the matching wording or guide pages if the message is still the main blocker.</li>
          </ul>
        </div>
      </div>
    </section>

    {isPhotoFeature && (
      <section class="mx-auto py-10" data-scroll>
        <h2 class="mb-5 text-2xl font-black tracking-tight" style="color:var(--color-text);">Photo invitation pages by occasion</h2>
        <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
          {photoOccasions.map((occasion) => (
            <a href={`/photo/${occasion.slug}/`} class="rounded-3xl border p-6 transition-all hover:-translate-y-1" style="background:var(--color-surface);border-color:var(--color-border);">
              <p class="text-3xl">{occasion.emoji}</p>
              <h3 class="mt-4 text-lg font-black" style="color:var(--color-text);">{occasion.name} photo invitations</h3>
              <p class="mt-2 text-sm leading-relaxed" style="color:var(--color-text-muted);">Open the photo-focused route for {occasion.name.toLowerCase()} card searches and jump into the upload flow faster.</p>
            </a>
          ))}
        </div>
      </section>
    )}

    {faqs.length > 0 && (
      <section class="mx-auto py-10" data-scroll>
        <h2 class="mb-5 text-2xl font-black tracking-tight" style="color:var(--color-text);">Feature FAQ</h2>
        <div class="space-y-3">
          {faqs.map((faq) => (
            <details class="group rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
              <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-black" style="color:var(--color-text);">
                {faq.question}
                <span class="transition-transform group-open:rotate-45" style="color:#7C3AED;">+</span>
              </summary>
              <p class="mt-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">{faq.answer}</p>
            </details>
          ))}
        </div>
      </section>
    )}
  </main>
  <Footer />
</Layout>
