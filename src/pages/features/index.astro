---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { PRODUCT_FEATURE_PAGES } from '../../lib/content';
import { SITE, absoluteUrl } from '../../lib/site';
import { articleSchema, breadcrumbSchema } from '../../lib/seo';

const path = '/features/';
const title = `Invitation Maker Features | ${SITE.name}`;
const description = 'Explore product-focused landing pages for photo cards, printable invitations, WhatsApp invites, hosted RSVP pages, and online card making.';
const schema = [
  articleSchema({ title, description, path }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Features', path },
  ]),
];
---

<Layout title={title} description={description} canonical={absoluteUrl(path)} schema={schema}>
  <Header />
  <main id="main-content" class="mx-auto max-w-7xl px-6 py-12">
    <div class="rounded-[2rem] border px-8 py-10" style="background:linear-gradient(135deg,#eef2ff,#fff7ed);border-color:#C4B5FD;">
      <p class="text-sm font-bold uppercase tracking-[0.24em]" style="color:#7C3AED;">Feature hub</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight" style="color:#1A1340;">Card maker features built for search intent and real invite workflows</h1>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed" style="color:#6B63A3;">
        These pages connect broad search intent like photo cards, printable invitations, online card makers, and hosted RSVP flows to the tools already live in the editor.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/photo/" class="rounded-full px-5 py-3 text-sm font-bold text-white" style="background:linear-gradient(135deg,#4F46E5,#7C3AED);">
          Browse photo invitation pages
        </a>
        <a href="/compare/online-invitation-with-rsvp/" class="rounded-full px-5 py-3 text-sm font-bold" style="background:var(--color-surface);color:var(--color-text);border:1px solid var(--color-border);">
          Compare RSVP invitation tools
        </a>
      </div>
    </div>

    <section class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-3" data-scroll>
      {PRODUCT_FEATURE_PAGES.map((feature) => (
        <a href={`/features/${feature.slug}/`} class="rounded-3xl border p-6 transition-all hover:-translate-y-1" style="background:var(--color-surface);border-color:var(--color-border);">
          <p class="text-xs font-bold uppercase tracking-[0.22em]" style="color:#ea580c;">Feature page</p>
          <h2 class="mt-3 text-2xl font-black" style="color:var(--color-text);">{feature.title}</h2>
          <p class="mt-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">{feature.description}</p>
        </a>
      ))}
    </section>
  </main>
  <Footer />
</Layout>
