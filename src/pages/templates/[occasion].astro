---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FaqSection from '../../components/FaqSection.astro';
import OccasionContentNav from '../../components/OccasionContentNav.astro';
import OccasionModifierGrid from '../../components/OccasionModifierGrid.astro';
import OccasionTemplateGallery from '../../components/OccasionTemplateGallery.astro';
import { OCCASIONS } from '../../lib/occasions';
import {
  getOccasionFaqs,
  getOccasionRelated,
  getOccasionTemplateHighlights,
} from '../../lib/landing';
import { SITE, absoluteUrl } from '../../lib/site';
import { articleSchema, breadcrumbSchema, faqSchema } from '../../lib/seo';

export function getStaticPaths() {
  return OCCASIONS.map((occasion) => ({
    params: { occasion: occasion.slug },
    props: { occasion },
  }));
}

const { occasion } = Astro.props;
const faqs = getOccasionFaqs(occasion);
const highlights = getOccasionTemplateHighlights(occasion);
const related = getOccasionRelated(occasion, 4);
const title = `Free ${occasion.name} Templates | ${SITE.name}`;
const description = `Browse ${occasion.templates.length} editable ${occasion.name.toLowerCase()} templates with printable, wording-ready, and shareable invitation options you can customize fast.`;
const schema = [
  articleSchema({
    title,
    description,
    path: `/templates/${occasion.slug}/`,
  }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Templates', path: '/templates/' },
    { name: occasion.name, path: `/templates/${occasion.slug}/` },
  ]),
  faqSchema(faqs),
];
---

<Layout title={title} description={description} canonical={absoluteUrl(`/templates/${occasion.slug}/`)} schema={schema}>
  <Header />

  <main id="main-content">
    <section class="mx-auto max-w-6xl px-6 py-12">
      <nav class="mb-6 text-sm text-[var(--color-text-muted)]" aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="transition-colors hover:text-indigo-600">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/templates/" class="transition-colors hover:text-indigo-600">Templates</a></li>
          <li aria-hidden="true">/</li>
          <li class="font-medium text-[var(--color-text)]">{occasion.name}</li>
        </ol>
      </nav>

      <div class="rounded-[2rem] border px-8 py-10" style="background:linear-gradient(135deg,#fff7f0,#eff6ff);border-color:#DDD6FE;">
        <p class="text-sm font-bold uppercase tracking-[0.26em]" style="color:#7C3AED;">Template page</p>
        <h1 class="mt-3 text-4xl font-black tracking-tight sm:text-5xl" style="color:#1A1340;">
          {occasion.name} invitation templates
        </h1>
        <p class="mt-4 max-w-3xl text-lg leading-relaxed" style="color:#6B63A3;">
          {description}
        </p>
      </div>
    </section>

    <OccasionTemplateGallery occasion={occasion} heading={`Editable ${occasion.name} templates`} intro={`Compare styles for ${occasion.name.toLowerCase()} events, review the template details, and open the editor when you are ready to personalize the design.`} linkMode="detail" />

    <section class="mx-auto max-w-6xl px-6 py-10" data-scroll>
      <h2 class="mb-5 text-2xl font-black tracking-tight" style="color:var(--color-text);">Template styles in this collection</h2>
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        {highlights.map((highlight) => (
          <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
            <h3 class="text-lg font-bold" style="color:var(--color-text);">{highlight.title}</h3>
            <p class="mt-2 text-sm leading-relaxed" style="color:var(--color-text-muted);">{highlight.description}</p>
          </div>
        ))}
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-10" data-scroll>
      <div class="grid gap-6 lg:grid-cols-[1fr_1fr]">
        <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
          <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">How to pick the right template faster</h2>
          <p class="mt-4 text-sm leading-relaxed" style="color:var(--color-text-muted);">
            A useful template page should help you narrow the field quickly, not just show a pile of similar cards. Start by deciding whether the event needs a more formal, playful, modern, family-friendly, or photo-led direction. Then check whether the layout leaves enough room for the names, date, venue, RSVP, and any extra detail the event requires. If a design looks attractive but cannot carry the information comfortably, it is usually the wrong starting point.
          </p>
          <p class="mt-4 text-sm leading-relaxed" style="color:var(--color-text-muted);">
            These collections are built to connect style choice with the next step. Once you have a design direction, you can move into wording help, hosted invite routes, or the live editor without starting the search over again.
          </p>
        </div>

        <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
          <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">What makes these pages more than a gallery</h2>
          <ul class="mt-4 space-y-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">
            <li>Each collection stays tied to a real invitation task and offers a useful set of design choices.</li>
            <li>The page links directly into editor flows, wording support, and modifier routes that reflect common user choices.</li>
            <li>Template descriptions are meant to help visitors compare use cases, not just repeat the occasion name.</li>
            <li>Related collections make it easier to find a different tone or format.</li>
          </ul>
        </div>
      </div>
    </section>

    <OccasionModifierGrid occasion={occasion} title={`Template users also search these ${occasion.name.toLowerCase()} routes`} />
    <OccasionContentNav occasion={occasion} title={`Use these ${occasion.name.toLowerCase()} templates with the right copy`} />
    <FaqSection title={`${occasion.name} template FAQ`} faqs={faqs} />

    <section class="mx-auto max-w-6xl px-6 py-10" data-scroll>
      <h2 class="mb-5 text-2xl font-black tracking-tight" style="color:var(--color-text);">Related template collections</h2>
      <div class="grid gap-4 md:grid-cols-4">
        {related.map((entry) => (
          <a href={`/templates/${entry.slug}/`} class="rounded-3xl border p-5 transition-all hover:-translate-y-1" style="background:var(--color-surface);border-color:var(--color-border);">
            <p class="text-2xl">{entry.emoji}</p>
            <p class="mt-3 text-sm font-bold" style="color:var(--color-text);">{entry.name} templates</p>
          </a>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
