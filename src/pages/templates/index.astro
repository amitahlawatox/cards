---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { OCCASIONS } from '../../lib/occasions';
import { SITE, absoluteUrl } from '../../lib/site';
import { articleSchema, breadcrumbSchema } from '../../lib/seo';

const schema = [
  articleSchema({
    title: `All Card Templates | 100+ Free Designs | ${SITE.name}`,
    description: 'Browse free invitation and greeting card templates across birthdays, weddings, baby showers, holidays, and business events.',
    path: '/templates/',
  }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Templates', path: '/templates/' },
  ]),
];
---

<Layout
  title={`All Card Templates | 100+ Free Designs | ${SITE.name}`}
  description="Browse 100+ free invitation and greeting card templates. Birthday, wedding, baby shower, graduation, holiday, and business designs included."
  canonical={absoluteUrl('/templates/')}
  schema={schema}
>
  <Header />

  <main id="main-content">
    <section class="relative overflow-hidden py-20 lg:py-28" style="background:linear-gradient(135deg,#fff7f0,#fef5ec);">
      <div class="absolute inset-0 pointer-events-none" style="background-image:radial-gradient(rgba(234,88,12,0.07) 1px,transparent 1px);background-size:32px 32px;" />
      <div class="relative mx-auto max-w-7xl px-6 text-center">
        <div class="badge-warm mb-6 inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-xs font-bold uppercase tracking-widest">
          Template Library
        </div>
        <h1 class="mb-4 font-black tracking-tight" style="font-size:clamp(2.5rem,6vw,4rem);color:#1A1340;line-height:1.05;">
          All Templates
        </h1>
        <p class="mx-auto mb-8 max-w-xl text-lg" style="color:#6B63A3;">
          Browse every design across all occasions, then open the template landing page or editor for the style you want.
        </p>
      </div>
    </section>

    {OCCASIONS.map((occasion) => (
      <section class="mx-auto max-w-7xl px-6 py-12" id={occasion.slug} data-scroll>
        <div class="mb-7 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <span class="text-3xl">{occasion.emoji}</span>
            <div>
              <h2 class="text-xl font-black" style="color:#1A1340;">{occasion.name}</h2>
              <p class="text-xs" style="color:#6B63A3;">{occasion.templates.length} templates</p>
            </div>
          </div>
          <a
            href={`/templates/${occasion.slug}/`}
            class="hidden items-center gap-1.5 text-sm font-bold transition-all hover:opacity-80 sm:flex"
            style="color:#ea580c;"
          >
            View template page
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5">
              <line x1="5" y1="12" x2="19" y2="12" />
              <polyline points="12 5 19 12 12 19" />
            </svg>
          </a>
        </div>

        <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6">
          {occasion.templates.map((template) => (
            <a
              href={`/templates/${occasion.slug}/`}
              class="group occasion-card cursor-pointer overflow-hidden rounded-2xl"
              style={`border:1px solid var(--color-border);background:${template.bg};`}
              title={`${template.name} - ${occasion.name}`}
            >
              <div class="relative aspect-[3/4] min-h-[140px] p-4 text-center">
                {template.pattern && (
                  <div class="absolute inset-0 pointer-events-none" style={`background-image:${template.pattern};background-size:24px 24px;opacity:0.7;`} />
                )}
                <div class="relative z-10 flex h-full flex-col items-center justify-center gap-1.5">
                  <div style={`width:28px;height:2px;background:${template.accentColor};border-radius:2px;opacity:0.8;`} />
                  <p class="max-w-[90%] text-xs font-bold leading-tight" style={`color:${template.textColor};font-size:10px;`}>
                    {template.defaultHeading.length > 20 ? `${template.defaultHeading.slice(0, 18)}...` : template.defaultHeading}
                  </p>
                  <div style={`width:20px;height:1px;background:${template.accentColor};opacity:0.4;`} />
                  <p style={`color:${template.textColor};font-size:8px;opacity:0.7;`}>
                    {template.defaultBody.split('\n')[0].slice(0, 22)}
                  </p>
                </div>
                <div
                  class="absolute inset-0 flex items-center justify-center opacity-0 transition-opacity duration-200 group-hover:opacity-100"
                  style="background:rgba(0,0,0,0.35);backdrop-filter:blur(2px);"
                >
                  <span class="rounded-full px-3 py-1.5 text-xs font-bold text-white" style="background:rgba(234,88,12,0.9);">
                    View templates
                  </span>
                </div>
              </div>
              <div class="border-t px-3 py-2.5" style="background:#fff;border-color:#E4E1FF;">
                <p class="truncate text-xs font-bold" style="color:#1A1340;">{template.name}</p>
                <p class="text-xs" style="color:#6B63A3;">{occasion.emoji} {occasion.name}</p>
              </div>
            </a>
          ))}
        </div>
      </section>
    ))}
  </main>

  <Footer />
</Layout>
