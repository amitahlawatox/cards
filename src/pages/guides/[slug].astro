---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { GUIDE_PAGES, getGuideExamples, getGuideRouteSuggestions, getGuideSearchQueries } from '../../lib/content';
import { EDITORIAL_DATES, EDITORIAL_TEAM, formatEditorialDate, getEditorialAuthorSchema } from '../../lib/editorial';
import { SITE, absoluteUrl } from '../../lib/site';
import { articleSchema, breadcrumbSchema, faqSchema } from '../../lib/seo';

export function getStaticPaths() {
  return GUIDE_PAGES.map((guide) => ({ params: { slug: guide.slug }, props: { guide } }));
}

const { guide } = Astro.props;
const examples = getGuideExamples(guide);
const queries = getGuideSearchQueries(guide);
const routeSuggestions = getGuideRouteSuggestions(guide);
const path = `/guides/${guide.slug}/`;
const publishedLabel = formatEditorialDate(EDITORIAL_DATES.published);
const modifiedLabel = formatEditorialDate(EDITORIAL_DATES.modified);
const guideFaqs = [
  {
    question: `When should I use this ${guide.title.toLowerCase()} guide?`,
    answer: 'Use it when the wording, timing, structure, or guest-facing detail is still the main blocker and you want to finish the invitation faster.',
  },
  {
    question: 'Should every detail go on the invitation card itself?',
    answer: 'No. A strong invitation keeps the essentials on the card and moves longer notes, schedules, dress guidance, or maps to a hosted invite page or follow-up message.',
  },
  {
    question: 'What should I do after using the examples on this page?',
    answer: 'Pick one structure, adapt it to your event, and then move into the matching occasion or feature page so the design and wording stay aligned.',
  },
];
const schema = [
  articleSchema({
    title: `${guide.title} | ${SITE.name}`,
    description: guide.description,
    path,
    type: 'BlogPosting',
    datePublished: EDITORIAL_DATES.published,
    dateModified: EDITORIAL_DATES.modified,
    author: getEditorialAuthorSchema(),
  }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Guides', path: '/guides/' },
    { name: guide.title, path },
  ]),
  faqSchema(guideFaqs),
];
---

<Layout title={`${guide.title} | ${SITE.name}`} description={guide.description} canonical={absoluteUrl(path)} schema={schema}>
  <Header />
  <main id="main-content" class="mx-auto max-w-5xl px-6 py-12">
    <div class="rounded-[2rem] border px-8 py-10" style="background:linear-gradient(135deg,#fff7f0,#fdf2f8);border-color:#FBCFE8;">
      <p class="text-sm font-bold uppercase tracking-[0.24em]" style="color:#ea580c;">Guide page</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight" style="color:#1A1340;">{guide.title}</h1>
      <p class="mt-4 text-lg leading-relaxed" style="color:#6B63A3;">{guide.intro}</p>
      <div class="mt-5 flex flex-wrap gap-4 text-sm" style="color:#6B63A3;">
        <span><strong>Published:</strong> {publishedLabel}</span>
        <span><strong>Updated:</strong> {modifiedLabel}</span>
        <span><strong>Reviewed by:</strong> {EDITORIAL_TEAM.name}</span>
      </div>
    </div>

    <section class="mt-8" data-scroll>
      <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
        <p class="text-xs font-bold uppercase tracking-[0.22em]" style="color:#ea580c;">Quick answer</p>
        <p class="mt-3 text-base leading-relaxed" style="color:var(--color-text-muted);">
          {guide.intro} Use one of the examples below as a starting structure, keep the card focused on the core event details, and move longer guest instructions to a hosted invite page or follow-up message when needed.
        </p>
        <dl class="mt-5 grid gap-4 md:grid-cols-2">
          <div class="rounded-2xl p-4" style="background:var(--color-surface-2);">
            <dt class="text-sm font-black" style="color:var(--color-text);">Best use</dt>
            <dd class="mt-2 text-sm leading-relaxed" style="color:var(--color-text-muted);">Open this guide when wording, timing, RSVP phrasing, or guest-facing clarity is the main blocker to finishing the invite.</dd>
          </div>
          <div class="rounded-2xl p-4" style="background:var(--color-surface-2);">
            <dt class="text-sm font-black" style="color:var(--color-text);">Best next step</dt>
            <dd class="mt-2 text-sm leading-relaxed" style="color:var(--color-text-muted);">After choosing the right message structure, move into a matching occasion, template, or RSVP flow so the wording and final format stay aligned.</dd>
          </div>
        </dl>
      </div>
    </section>

    <section class="mt-10 grid gap-5 md:grid-cols-3" data-scroll>
      {guide.bullets.map((bullet, index) => (
        <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
          <p class="text-xs font-bold uppercase tracking-[0.22em]" style="color:#ea580c;">Tip {index + 1}</p>
          <p class="mt-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">{bullet}</p>
        </div>
      ))}
    </section>

    <section class="mx-auto py-10" data-scroll>
      <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
        <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">How to use this guide well</h2>
        <p class="mt-4 text-sm leading-relaxed" style="color:var(--color-text-muted);">
          This guide is meant to remove one specific point of friction in the invitation process. Most visitors already know the event type, but they still need help with the exact wording, planning sequence, or guest-facing detail that makes the finished invite feel clear and complete.
        </p>
        <p class="mt-4 text-sm leading-relaxed" style="color:var(--color-text-muted);">
          The fastest workflow is usually to borrow one structure from the examples, adapt it to your event, and then move into the matching occasion or feature page. That keeps the guide useful without forcing you to write the whole message from scratch.
        </p>
        <p class="mt-4 text-sm leading-relaxed" style="color:var(--color-text-muted);">
          If the card starts to feel crowded, use the guide to decide what belongs on the invitation itself and what should move into a hosted invite page, follow-up message, or RSVP note.
        </p>
      </div>
    </section>

    <section class="mx-auto py-10" data-scroll>
      <h2 class="mb-5 text-2xl font-black tracking-tight" style="color:var(--color-text);">Example lines</h2>
      <div class="grid gap-4 md:grid-cols-3">
        {examples.map((example) => (
          <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
            <p class="text-sm leading-relaxed" style="color:var(--color-text-muted);">{example}</p>
          </div>
        ))}
      </div>
    </section>

    {queries.length > 0 && (
      <section class="mx-auto py-4" data-scroll>
        <h2 class="mb-5 text-2xl font-black tracking-tight" style="color:var(--color-text);">Common searches behind this guide</h2>
        <div class="flex flex-wrap gap-3">
          {queries.map((query) => (
            <span class="rounded-full border px-4 py-2 text-sm font-semibold" style="background:var(--color-surface);border-color:var(--color-border);color:var(--color-text-muted);">
              {query}
            </span>
          ))}
        </div>
      </section>
    )}

    {routeSuggestions.length > 0 && (
      <section class="mx-auto py-10" data-scroll>
        <h2 class="mb-5 text-2xl font-black tracking-tight" style="color:var(--color-text);">Best next pages after this guide</h2>
        <div class="grid gap-4 md:grid-cols-3">
          {routeSuggestions.map((route) => (
            <a href={route.href} class="rounded-3xl border p-6 transition-all hover:-translate-y-1" style="background:var(--color-surface);border-color:var(--color-border);">
              <h3 class="text-lg font-black" style="color:var(--color-text);">{route.title}</h3>
              <p class="mt-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">{route.description}</p>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="mx-auto py-4" data-scroll>
      <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
        <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">Common mistakes this guide helps avoid</h2>
        <ul class="mt-4 space-y-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">
          <li>Using wording that sounds polished but still leaves out one practical guest detail.</li>
          <li>Copying a format that does not match the tone, venue, or audience for the event.</li>
          <li>Trying to fit schedule, dress code, and long directions into a card that should stay concise.</li>
          <li>Switching to the editor before the message structure and guest information are clear.</li>
        </ul>
      </div>
    </section>

    <section class="mx-auto py-10" data-scroll>
      <h2 class="mb-5 text-2xl font-black tracking-tight" style="color:var(--color-text);">Guide FAQ</h2>
      <div class="space-y-3">
        {guideFaqs.map((faq) => (
          <details class="group rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-lg font-black" style="color:var(--color-text);">
              {faq.question}
              <span class="transition-transform group-open:rotate-45" style="color:#7C3AED;">+</span>
            </summary>
            <p class="mt-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">{faq.answer}</p>
          </details>
        ))}
      </div>
    </section>

    <section class="mx-auto py-4" data-scroll>
      <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
        <p class="text-xs font-bold uppercase tracking-[0.22em]" style="color:#ea580c;">Editorial review</p>
        <h2 class="mt-3 text-2xl font-black tracking-tight" style="color:var(--color-text);">{EDITORIAL_TEAM.name}</h2>
        <p class="mt-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">
          {EDITORIAL_TEAM.bio}
        </p>
        <p class="mt-4 text-sm leading-relaxed" style="color:var(--color-text-muted);">
          This page was published on {publishedLabel} and last reviewed on {modifiedLabel}. We update guide content when invitation workflows, product capabilities, or content-quality audits show that users need clearer help.
        </p>
        <div class="mt-5 flex flex-wrap gap-3">
          <a href={EDITORIAL_TEAM.profilePath} class="rounded-full px-5 py-3 text-sm font-bold text-white" style="background:linear-gradient(135deg,#4F46E5,#7C3AED);">
            View team profile
          </a>
          <a href={EDITORIAL_TEAM.policyPath} class="rounded-full px-5 py-3 text-sm font-bold" style="background:var(--color-surface-2);color:var(--color-text);border:1px solid var(--color-border);">
            Review content standards
          </a>
          <a href={EDITORIAL_TEAM.contactPath} class="rounded-full px-5 py-3 text-sm font-bold" style="background:var(--color-surface-2);color:var(--color-text);border:1px solid var(--color-border);">
            Contact the team
          </a>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
