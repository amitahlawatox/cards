---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { GUIDE_PAGES } from '../../lib/content';
import { SITE, absoluteUrl } from '../../lib/site';
import { articleSchema, breadcrumbSchema } from '../../lib/seo';

const schema = [
  articleSchema({
    title: `Invitation Planning Guides | ${SITE.name}`,
    description: 'Guides for RSVP wording, dress code wording, party schedules, invitation messages, and occasion-specific wording help.',
    path: '/guides/',
  }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Guides', path: '/guides/' },
  ]),
];
---

<Layout title={`Invitation Planning Guides | ${SITE.name}`} description="Guides for RSVP wording, dress code wording, party schedules, invitation messages, and occasion-specific wording help." canonical={absoluteUrl('/guides/')} schema={schema}>
  <Header />
  <main id="main-content" class="mx-auto max-w-7xl px-6 py-12">
    <div class="mb-10 max-w-3xl">
      <p class="text-sm font-bold uppercase tracking-[0.24em]" style="color:#ea580c;">Editorial guides</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight" style="color:var(--color-text);">Planning guides that help users finish the invite</h1>
      <p class="mt-3 text-base leading-relaxed" style="color:var(--color-text-muted);">These pages are built to support search intent that sits one step before the actual invitation design task.</p>
    </div>
    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {GUIDE_PAGES.map((guide) => (
        <a href={`/guides/${guide.slug}/`} class="rounded-3xl border p-6 transition-all hover:-translate-y-1" style="background:var(--color-surface);border-color:var(--color-border);">
          <h2 class="text-xl font-black" style="color:var(--color-text);">{guide.title}</h2>
          <p class="mt-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">{guide.description}</p>
        </a>
      ))}
    </div>
  </main>
  <Footer />
</Layout>
