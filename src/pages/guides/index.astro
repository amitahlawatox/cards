---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { GUIDE_PAGES } from '../../lib/content';
import { SITE, absoluteUrl } from '../../lib/site';
import { articleSchema, breadcrumbSchema } from '../../lib/seo';

const schema = [
  articleSchema({
    title: `Invitation Planning Guides | ${SITE.name}`,
    description: 'Guides for RSVP wording, invitation timing, venue wording, Indian wedding wording, dress codes, schedules, and message templates.',
    path: '/guides/',
  }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Guides', path: '/guides/' },
  ]),
];
---

<Layout title={`Invitation Planning Guides | ${SITE.name}`} description="Guides for RSVP wording, invitation timing, venue wording, Indian wedding wording, dress codes, schedules, and message templates." canonical={absoluteUrl('/guides/')} schema={schema}>
  <Header />
  <main id="main-content" class="mx-auto max-w-7xl px-6 py-12">
    <div class="mb-10 max-w-3xl">
      <p class="text-sm font-bold uppercase tracking-[0.24em]" style="color:#ea580c;">Editorial guides</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight" style="color:var(--color-text);">Planning guides that help users finish the invite</h1>
      <p class="mt-3 text-base leading-relaxed" style="color:var(--color-text-muted);">These pages are built to support search intent that sits one step before the actual invitation design task, including send timing, venue wording, Indian family-event copy, and RSVP language.</p>
    </div>
    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {GUIDE_PAGES.map((guide) => (
        <a href={`/guides/${guide.slug}/`} class="rounded-3xl border p-6 transition-all hover:-translate-y-1" style="background:var(--color-surface);border-color:var(--color-border);">
          <h2 class="text-xl font-black" style="color:var(--color-text);">{guide.title}</h2>
          <p class="mt-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">{guide.description}</p>
        </a>
      ))}
    </div>

    <section class="mt-10 grid gap-6 lg:grid-cols-[1fr_1fr]" data-scroll>
      <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
        <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">Why these guides exist</h2>
        <p class="mt-4 text-sm leading-relaxed" style="color:var(--color-text-muted);">
          Invitation users often get stuck before they ever choose a design. They know the event, but they still need help with message structure, RSVP wording, venue lines, send timing, dress code notes, or family-specific etiquette. These guide pages are built to solve those planning blockers directly.
        </p>
        <p class="mt-4 text-sm leading-relaxed" style="color:var(--color-text-muted);">
          Each guide is meant to hand users back into the editor, an occasion hub, or a stronger product route once the wording problem is solved.
        </p>
      </div>

      <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
        <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">Best way to use the guide library</h2>
        <ul class="mt-4 space-y-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">
          <li>Start with the narrowest problem, such as RSVP wording or venue wording.</li>
          <li>Borrow one usable structure instead of trying to combine five examples at once.</li>
          <li>Move to the matching template or occasion page once the guest-facing message is clear.</li>
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
