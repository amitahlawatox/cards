---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SITE, absoluteUrl } from '../../lib/site';
import { articleSchema, breadcrumbSchema } from '../../lib/seo';

const path = '/contact/';
const title = `Contact ${SITE.name}`;
const description = `Contact ${SITE.name} for support, template feedback, bug reports, partnership questions, and publisher inquiries.`;
const schema = [
  articleSchema({ title, description, path }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Contact', path },
  ]),
];
---

<Layout title={title} description={description} canonical={absoluteUrl(path)} schema={schema}>
  <Header />

  <main id="main-content" class="mx-auto max-w-5xl px-6 py-12">
    <div class="rounded-[2rem] border px-8 py-10" style="background:linear-gradient(135deg,#fff7f0,#eef2ff);border-color:#DDD6FE;">
      <p class="text-sm font-bold uppercase tracking-[0.24em]" style="color:#ea580c;">Contact</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight" style="color:#1A1340;">Get in touch with {SITE.name}</h1>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed" style="color:#6B63A3;">
        If you have a question about templates, wording, downloads, hosted invite pages, or a problem in the editor, contact us and include the page or occasion you were using.
      </p>
    </div>

    <section class="mt-10 grid gap-6 md:grid-cols-2" data-scroll>
      <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
        <p class="text-xs font-bold uppercase tracking-[0.22em]" style="color:#ea580c;">Email</p>
        <h2 class="mt-3 text-2xl font-black tracking-tight" style="color:var(--color-text);">Support and feedback</h2>
        <p class="mt-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">
          For template requests, wording suggestions, bug reports, or questions about how the card maker works, email us directly.
        </p>
        <a href={`mailto:${SITE.email}`} class="mt-5 inline-flex rounded-full px-5 py-3 text-sm font-bold text-white" style="background:linear-gradient(135deg,#4F46E5,#7C3AED);">
          {SITE.email}
        </a>
      </div>

      <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
        <p class="text-xs font-bold uppercase tracking-[0.22em]" style="color:#ea580c;">What helps us reply faster</p>
        <ul class="mt-4 space-y-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">
          <li>Include the occasion or template name you were using.</li>
          <li>Share the page URL if the issue happened on a specific route.</li>
          <li>Describe the device or browser if something did not render correctly.</li>
          <li>Mention whether the issue affected editing, downloads, hosted invites, or wording guidance.</li>
        </ul>
      </div>
    </section>

    <section class="mt-10 grid gap-6 md:grid-cols-3" data-scroll>
      {[
        ['Template requests', 'Tell us which event, style, or market-specific template you want us to add next.'],
        ['Bug reports', 'Share broken layouts, missing downloads, text issues, or page problems so we can fix them quickly.'],
        ['Partnerships', 'Use the same contact email for product partnerships, publisher questions, or business outreach.'],
      ].map(([title, body]) => (
        <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
          <h2 class="text-lg font-black" style="color:var(--color-text);">{title}</h2>
          <p class="mt-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">{body}</p>
        </div>
      ))}
    </section>

    <section class="mt-10 rounded-3xl border p-6" data-scroll style="background:var(--color-surface);border-color:var(--color-border);">
      <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">What happens after you contact us</h2>
      <p class="mt-4 text-sm leading-relaxed" style="color:var(--color-text-muted);">
        Support messages help us improve more than one ticket at a time. We use real feedback to fix broken pages, expand template coverage, refine wording guidance, and spot weak journeys that could otherwise create low-value content or a poor user experience for future visitors.
      </p>
      <p class="mt-4 text-sm leading-relaxed" style="color:var(--color-text-muted);">
        That feedback loop matters for quality and trust. It gives us a direct way to validate whether our invitation flows, export tools, and help content are solving real user problems instead of just filling pages with surface-level copy.
      </p>
    </section>

    <section class="mt-10 grid gap-6 md:grid-cols-2" data-scroll>
      <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
        <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">Questions that are especially helpful</h2>
        <p class="mt-4 text-sm leading-relaxed" style="color:var(--color-text-muted);">
          We welcome more than bug reports. If you could not find a template for a specific event, felt confused by a wording page, hit a problem with downloads, or needed a stronger RSVP or hosted-invite workflow, that feedback helps us improve the product and the guidance around it.
        </p>
      </div>

      <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
        <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">Why this matters for trust</h2>
        <p class="mt-4 text-sm leading-relaxed" style="color:var(--color-text-muted);">
          A visible contact route gives you a clear way to reach the team, helps us check that the site solves real invitation problems, and makes us accountable for correcting mistakes and responding to accessibility or product concerns.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
