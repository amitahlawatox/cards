---
import Layout from '../../../layouts/Layout.astro';
import Header from '../../../components/Header.astro';
import Footer from '../../../components/Footer.astro';
import FaqSection from '../../../components/FaqSection.astro';
import OccasionContentNav from '../../../components/OccasionContentNav.astro';
import OccasionTemplateGallery from '../../../components/OccasionTemplateGallery.astro';
import { getModifierChecklist, getModifierPageDescription, getModifierStaticPaths } from '../../../lib/content';
import { getOccasionFaqs, getOccasionRelated } from '../../../lib/landing';
import { SITE, absoluteUrl } from '../../../lib/site';
import { articleSchema, breadcrumbSchema, faqSchema } from '../../../lib/seo';

export function getStaticPaths() {
  return getModifierStaticPaths();
}

const { occasion, modifier } = Astro.props;
const description = getModifierPageDescription(occasion, modifier);
const faqs = getOccasionFaqs(occasion);
const checklist = getModifierChecklist(occasion, modifier);
const related = getOccasionRelated(occasion, 4);
const path = `/invitations/${occasion.slug}/${modifier.slug}/`;
const title = `${modifier.label} ${occasion.name} Invitations | ${SITE.name}`;
const schema = [
  articleSchema({ title, description, path }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Invitations', path: '/invitations/' },
    { name: occasion.name, path: `/invitations/${occasion.slug}/` },
    { name: modifier.label, path },
  ]),
  faqSchema(faqs),
];
---

<Layout title={title} description={description} canonical={absoluteUrl(path)} schema={schema}>
  <Header />

  <main id="main-content" class="mx-auto max-w-6xl px-6 py-12">
    <div class="rounded-[2rem] border px-8 py-10" style="background:linear-gradient(135deg,#fff7f0,#fdf2f8);border-color:#FBCFE8;">
      <p class="text-sm font-bold uppercase tracking-[0.24em]" style="color:#ea580c;">Long-tail page</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight" style="color:#1A1340;">{modifier.label} {occasion.name} invitations</h1>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed" style="color:#6B63A3;">{description}</p>
    </div>

    <section class="mt-10 grid gap-5 md:grid-cols-3" data-scroll>
      {checklist.map((item, index) => (
        <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
          <p class="text-xs font-bold uppercase tracking-[0.22em]" style="color:#ea580c;">Priority {index + 1}</p>
          <p class="mt-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">{item}</p>
        </div>
      ))}
    </section>

    <OccasionTemplateGallery occasion={occasion} heading={`${modifier.label} ${occasion.name} invitation templates`} limit={6} linkMode="detail" />
    <OccasionContentNav occasion={occasion} title={`Use these ${modifier.label.toLowerCase()} ideas across the invite flow`} />
    <FaqSection title={`${modifier.label} ${occasion.name} invitation FAQ`} faqs={faqs} />

    <section class="mx-auto max-w-6xl py-10" data-scroll>
      <h2 class="mb-5 text-2xl font-black tracking-tight" style="color:var(--color-text);">Related occasion pages</h2>
      <div class="grid gap-4 md:grid-cols-4">
        {related.map((entry) => (
          <a href={`/invitations/${entry.slug}/${modifier.slug}/`} class="rounded-3xl border p-5 transition-all hover:-translate-y-1" style="background:var(--color-surface);border-color:var(--color-border);">
            <p class="text-2xl">{entry.emoji}</p>
            <p class="mt-3 text-sm font-bold" style="color:var(--color-text);">{modifier.label} {entry.name} invitations</p>
          </a>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
