---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FaqSection from '../../components/FaqSection.astro';
import OccasionContentNav from '../../components/OccasionContentNav.astro';
import OccasionTemplateGallery from '../../components/OccasionTemplateGallery.astro';
import { OCCASIONS } from '../../lib/occasions';
import {
  getOccasionChecklist,
  getOccasionFaqs,
  getOccasionRelated,
  getOccasionWordingExamples,
} from '../../lib/landing';
import { SITE, absoluteUrl } from '../../lib/site';
import { articleSchema, breadcrumbSchema, faqSchema } from '../../lib/seo';

export function getStaticPaths() {
  return OCCASIONS.map((occasion) => ({
    params: { occasion: occasion.slug },
    props: { occasion },
  }));
}

const { occasion } = Astro.props;
const defaultFaqs = getOccasionFaqs(occasion);
const defaultWordingExamples = getOccasionWordingExamples(occasion);
const checklist = getOccasionChecklist(occasion);
const related = getOccasionRelated(occasion, 4);
const wordingPilots = {
  farewell: {
    title: `Farewell Party Invitation Wording & Message Examples | ${SITE.name}`,
    description: 'Use warm, funny and workplace-ready farewell invitation wording, with examples for leaving parties, retirement send-offs, RSVP notes and group messages.',
    heading: 'Farewell Party Invitation Wording Examples',
    intro: 'A farewell invitation should say who is leaving, why you are gathering and what guests need to do next. Choose a tone that fits the relationship—warm for friends, polished for colleagues or light-hearted for a casual send-off—then add the date, venue and RSVP deadline.',
    examples: [
      { title: 'Office leaving party', body: 'Join us to thank [Name] and wish them well in their new role.\n[Date] · [Time] · [Venue]\nPlease RSVP to [Contact] by [Deadline].' },
      { title: 'Friend moving away', body: 'Before [Name] starts their next adventure, let’s get together for one last celebration.\n[Date] · [Venue]\nCome ready to share a favourite memory.' },
      { title: 'Virtual team send-off', body: 'You’re invited to a virtual farewell for [Name].\nJoin us on [Platform] at [Time and time zone].\nThe meeting link will be shared after you reply.' },
      { title: 'Surprise farewell', body: 'Please keep this a surprise: we’re celebrating [Name] before they leave.\nArrive by [Time] at [Venue].\nRSVP privately to [Contact].' },
    ],
    faqs: [
      { question: 'What do you write in a farewell party invitation?', answer: 'Name the person leaving, explain the occasion, and include the date, time, venue and RSVP method. Add a warm or light-hearted line that suits your relationship.' },
      { question: 'How do you invite colleagues to a leaving party?', answer: 'Use clear, friendly wording and say whether the event is during work hours, after work or online. Include any contribution or card arrangements separately.' },
      { question: 'Should a farewell invitation mention gifts?', answer: 'Only when guests genuinely need the information. Keep gifts optional and explain any collection clearly without creating pressure.' },
      { question: 'How far ahead should a farewell invitation be sent?', answer: 'One to three weeks is usually practical for a local gathering. Allow longer when guests need to travel or the event needs catering numbers.' },
    ],
  },
  'kids-party': {
    title: `Kids’ Party Invitation Wording & Message Examples | ${SITE.name}`,
    description: 'Copy and adapt kids’ party invitation wording for birthdays, themed parties and play dates, including RSVP, drop-off, allergy and parent-attendance notes.',
    heading: 'Kids’ Party Invitation Wording Ideas',
    intro: 'Good children’s party wording is cheerful for the child and clear for the adult reading it. Include the child’s name and age, the party theme, start and finish times, venue, RSVP deadline and whether parents should stay.',
    examples: [
      { title: 'Classic birthday party', body: '[Name] is turning [Age]! Join us for games, cake and birthday fun.\n[Date] · [Start time]–[Finish time] · [Venue]\nRSVP by [Deadline].' },
      { title: 'Drop-off party', body: 'Children can be dropped off at [Start time] and collected at [Finish time]. Please share an emergency contact and any allergy information when you RSVP.' },
      { title: 'Parents stay', body: 'A parent or carer is welcome to stay throughout the party. Tea and snacks will be available while the children play.' },
      { title: 'Allergy-aware note', body: 'Please tell us about allergies or dietary needs by [Deadline] so we can plan food and treats safely.' },
      { title: 'Siblings note', body: 'Space is limited to invited children only. Thank you for helping us plan the activities and food.' },
    ],
    faqs: [
      { question: 'How do I say parents can drop off?', answer: 'State the drop-off and collection times, ask for an emergency contact and make clear which adult will supervise the party.' },
      { question: 'How do I ask about allergies?', answer: 'Add a short RSVP note asking parents or carers to share allergies and dietary needs by a specific deadline.' },
      { question: 'Should I include an end time?', answer: 'Yes. A clear finish time helps families plan collection and avoids uncertainty.' },
      { question: 'How do I say siblings are or are not invited?', answer: 'Be direct and kind. Say either that siblings are welcome with an RSVP, or that space is limited to the named child.' },
    ],
  },
};
const pilot = wordingPilots[occasion.slug as keyof typeof wordingPilots];
const title = pilot?.title ?? `${occasion.name} Invitation Wording | ${SITE.name}`;
const description = pilot?.description ?? `Browse ${occasion.name.toLowerCase()} invitation wording examples, guest-ready message ideas, RSVP prompts, and a clear checklist for what to include.`;
const heading = pilot?.heading ?? `${occasion.name} invitation wording ideas`;
const intro = pilot?.intro ?? description;
const wordingExamples = pilot?.examples ?? defaultWordingExamples;
const faqs = pilot?.faqs ?? defaultFaqs;
const schema = [
  articleSchema({
    title,
    description,
    path: `/wording/${occasion.slug}/`,
  }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Wording', path: '/wording/' },
    { name: occasion.name, path: `/wording/${occasion.slug}/` },
  ]),
  faqSchema(faqs),
];
---

<Layout title={title} description={description} canonical={absoluteUrl(`/wording/${occasion.slug}/`)} schema={schema}>
  <Header />

  <main id="main-content">
    <section class="mx-auto max-w-6xl px-6 py-12">
      <nav class="mb-6 text-sm text-[var(--color-text-muted)]" aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="transition-colors hover:text-indigo-600">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/wording/" class="transition-colors hover:text-indigo-600">Wording</a></li>
          <li aria-hidden="true">/</li>
          <li class="font-medium text-[var(--color-text)]">{occasion.name}</li>
        </ol>
      </nav>

      <div class="rounded-[2rem] border px-8 py-10" style="background:linear-gradient(135deg,#fff7f0,#eef2ff);border-color:#C4B5FD;">
        <p class="text-sm font-bold uppercase tracking-[0.26em]" style="color:#7C3AED;">Wording page</p>
        <h1 class="mt-3 text-4xl font-black tracking-tight sm:text-5xl" style="color:#1A1340;">
          {heading}
        </h1>
        <p class="mt-4 max-w-3xl text-lg leading-relaxed" style="color:#6B63A3;">
          {intro}
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-10" data-scroll>
      <div class="grid gap-4 lg:grid-cols-2">
        {wordingExamples.map((example) => (
          <article class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
            <h2 class="text-lg font-bold" style="color:var(--color-text);">{example.title}</h2>
            <p class="mt-3 whitespace-pre-line text-sm leading-relaxed" style="color:var(--color-text-muted);">{example.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-10" data-scroll>
      <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
        <h2 class="text-xl font-black" style="color:var(--color-text);">What to include in your wording</h2>
        <ul class="mt-4 grid gap-3 md:grid-cols-2 text-sm" style="color:var(--color-text-muted);">
          {checklist.map((item) => (
            <li class="flex gap-3">
              <span class="mt-1 h-2 w-2 rounded-full bg-orange-400"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-10" data-scroll>
      <div class="grid gap-6 lg:grid-cols-[1fr_1fr]">
        <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
          <h2 class="text-xl font-black" style="color:var(--color-text);">How to adapt this wording so it sounds real</h2>
          <p class="mt-4 text-sm leading-relaxed" style="color:var(--color-text-muted);">
            The strongest invitation wording usually does three things well: it tells guests what is happening, it sounds natural for the relationship between host and guest, and it keeps the practical details easy to scan. That means you should not copy a sample word for word unless it already fits the tone of your event. Use the examples on this page as a structure, then swap in the real host names, the reason for gathering, and the level of formality your guests will expect.
          </p>
          <p class="mt-4 text-sm leading-relaxed" style="color:var(--color-text-muted);">
            For example, family gatherings and festive invitations often benefit from warmer language, while weddings, office events, and venue-led dinners usually need clearer time, RSVP, and dress details. The page is meant to help you finish that wording job faster, not trap you in vague filler copy.
          </p>
        </div>

        <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
          <h2 class="text-xl font-black" style="color:var(--color-text);">When to move details off the card</h2>
          <ul class="mt-4 space-y-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">
            <li>Keep the card short when guests mainly need the event title, date, venue, and RSVP method.</li>
            <li>Move longer schedule notes, parking details, apartment access, registry links, and map help onto a hosted invite page.</li>
            <li>Use a follow-up message or RSVP page when the event has multiple sub-events, meal choices, or guest questions.</li>
            <li>Choose wording that matches the final format so the invitation feels clear in print, on WhatsApp, or on a shareable hosted page.</li>
          </ul>
        </div>
      </div>
    </section>

    <OccasionContentNav occasion={occasion} title={`Turn your ${occasion.name.toLowerCase()} wording into a finished card`} />
    <OccasionTemplateGallery occasion={occasion} heading={`Templates that match this ${occasion.name.toLowerCase()} wording`} limit={4} />
    <FaqSection title={`${occasion.name} wording FAQ`} faqs={faqs} />

    <section class="mx-auto max-w-6xl px-6 py-10" data-scroll>
      <h2 class="mb-5 text-2xl font-black tracking-tight" style="color:var(--color-text);">More wording pages</h2>
      <div class="grid gap-4 md:grid-cols-4">
        {related.map((entry) => (
          <a href={`/wording/${entry.slug}/`} class="rounded-3xl border p-5 transition-all hover:-translate-y-1" style="background:var(--color-surface);border-color:var(--color-border);">
            <p class="text-2xl">{entry.emoji}</p>
            <p class="mt-3 text-sm font-bold" style="color:var(--color-text);">{entry.name} wording</p>
          </a>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
