---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import FaqSection from '../../components/FaqSection.astro';
import OccasionContentNav from '../../components/OccasionContentNav.astro';
import OccasionTemplateGallery from '../../components/OccasionTemplateGallery.astro';
import { OCCASIONS } from '../../lib/occasions';
import {
  getOccasionChecklist,
  getOccasionFaqs,
  getOccasionRelated,
  getOccasionWordingExamples,
} from '../../lib/landing';
import { SITE, absoluteUrl } from '../../lib/site';
import { articleSchema, breadcrumbSchema, faqSchema } from '../../lib/seo';

export function getStaticPaths() {
  return OCCASIONS.map((occasion) => ({
    params: { occasion: occasion.slug },
    props: { occasion },
  }));
}

const { occasion } = Astro.props;
const faqs = getOccasionFaqs(occasion);
const wordingExamples = getOccasionWordingExamples(occasion);
const checklist = getOccasionChecklist(occasion);
const related = getOccasionRelated(occasion, 4);
const title = `${occasion.name} Invitation Wording and Message Ideas | ${SITE.name}`;
const description = `Browse ${occasion.name.toLowerCase()} invitation wording examples, casual and formal message ideas, and a quick checklist for what to include.`;
const schema = [
  articleSchema({
    title,
    description,
    path: `/wording/${occasion.slug}/`,
  }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Wording', path: '/wording/' },
    { name: occasion.name, path: `/wording/${occasion.slug}/` },
  ]),
  faqSchema(faqs),
];
---

<Layout title={title} description={description} canonical={absoluteUrl(`/wording/${occasion.slug}/`)} schema={schema}>
  <Header />

  <main id="main-content">
    <section class="mx-auto max-w-6xl px-6 py-12">
      <nav class="mb-6 text-sm text-[var(--color-text-muted)]" aria-label="Breadcrumb">
        <ol class="flex flex-wrap items-center gap-2">
          <li><a href="/" class="transition-colors hover:text-indigo-600">Home</a></li>
          <li aria-hidden="true">/</li>
          <li><a href="/wording/" class="transition-colors hover:text-indigo-600">Wording</a></li>
          <li aria-hidden="true">/</li>
          <li class="font-medium text-[var(--color-text)]">{occasion.name}</li>
        </ol>
      </nav>

      <div class="rounded-[2rem] border px-8 py-10" style="background:linear-gradient(135deg,#fff7f0,#eef2ff);border-color:#C4B5FD;">
        <p class="text-sm font-bold uppercase tracking-[0.26em]" style="color:#7C3AED;">Wording page</p>
        <h1 class="mt-3 text-4xl font-black tracking-tight sm:text-5xl" style="color:#1A1340;">
          {occasion.name} invitation wording ideas
        </h1>
        <p class="mt-4 max-w-3xl text-lg leading-relaxed" style="color:#6B63A3;">
          {description}
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-10" data-scroll>
      <div class="grid gap-4 lg:grid-cols-2">
        {wordingExamples.map((example) => (
          <article class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
            <h2 class="text-lg font-bold" style="color:var(--color-text);">{example.title}</h2>
            <p class="mt-3 whitespace-pre-line text-sm leading-relaxed" style="color:var(--color-text-muted);">{example.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-10" data-scroll>
      <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
        <h2 class="text-xl font-black" style="color:var(--color-text);">What to include in your wording</h2>
        <ul class="mt-4 grid gap-3 md:grid-cols-2 text-sm" style="color:var(--color-text-muted);">
          {checklist.map((item) => (
            <li class="flex gap-3">
              <span class="mt-1 h-2 w-2 rounded-full bg-orange-400"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <OccasionContentNav occasion={occasion} title={`Turn your ${occasion.name.toLowerCase()} wording into a finished card`} />
    <OccasionTemplateGallery occasion={occasion} heading={`Templates that match this ${occasion.name.toLowerCase()} wording`} limit={4} />
    <FaqSection title={`${occasion.name} wording FAQ`} faqs={faqs} />

    <section class="mx-auto max-w-6xl px-6 py-10" data-scroll>
      <h2 class="mb-5 text-2xl font-black tracking-tight" style="color:var(--color-text);">More wording pages</h2>
      <div class="grid gap-4 md:grid-cols-4">
        {related.map((entry) => (
          <a href={`/wording/${entry.slug}/`} class="rounded-3xl border p-5 transition-all hover:-translate-y-1" style="background:var(--color-surface);border-color:var(--color-border);">
            <p class="text-2xl">{entry.emoji}</p>
            <p class="mt-3 text-sm font-bold" style="color:var(--color-text);">{entry.name} wording</p>
          </a>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
