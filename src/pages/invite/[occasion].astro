---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import InvitationViewer from '../../components/InvitationViewer';
import { OCCASIONS } from '../../lib/occasions';
import { SITE, absoluteUrl } from '../../lib/site';
import { breadcrumbSchema } from '../../lib/seo';

export function getStaticPaths() {
  return OCCASIONS.map((occasion) => ({
    params: { occasion: occasion.slug },
    props: { occasion },
  }));
}

const { occasion } = Astro.props;
const schema = [
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Hosted Invite', path: `/invite/${occasion.slug}/` },
  ]),
];
---

<Layout
  title={`${occasion.name} Hosted Invitation | ${SITE.name}`}
  description={`Preview and share a hosted ${occasion.name.toLowerCase()} invitation page generated from the editor.`}
  canonical={absoluteUrl(`/invite/${occasion.slug}/`)}
  schema={schema}
  noIndex={true}
>
  <Header />

  <main id="main-content" class="mx-auto max-w-7xl px-6 py-12">
    <div class="mb-8 max-w-3xl">
      <p class="text-sm font-bold uppercase tracking-[0.24em]" style="color:#ea580c;">Hosted invitation</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight" style="color:var(--color-text);">{occasion.name} invitation page</h1>
      <p class="mt-3 text-base leading-relaxed" style="color:var(--color-text-muted);">
        This page lets the host share a card preview, event details, calendar-ready timing, location notes, and structured RSVP actions without needing a separate account system.
      </p>
    </div>

    <InvitationViewer client:load occasionName={occasion.name} />

    <section class="mt-10 grid gap-6 lg:grid-cols-[1fr_1fr]" data-scroll>
      <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
        <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">What a hosted invite should help a guest do</h2>
        <p class="mt-4 text-sm leading-relaxed" style="color:var(--color-text-muted);">
          A useful hosted invitation does more than show a design. It should help guests understand the event, confirm the date and time quickly, check location details, and respond without jumping between multiple apps or long message threads.
        </p>
      </div>

      <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
        <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">Why this route stays out of search</h2>
        <p class="mt-4 text-sm leading-relaxed" style="color:var(--color-text-muted);">
          Hosted invitation pages are built for direct sharing after a card has been created. Because they may contain personal event details, they are kept private by default while hosts still get a clean page to share with their guests.
        </p>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
