---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import OccasionsGrid from '../../components/OccasionsGrid';
import { OCCASIONS } from '../../lib/occasions';
import { SITE, absoluteUrl } from '../../lib/site';
---

<Layout
  title={`All Occasions | ${SITE.name}`}
  description="Browse all free invitation and greeting card occasions. Birthday, wedding, baby shower, graduation, Eid, Diwali, Halloween, and more. No sign-up required."
  canonical={absoluteUrl('/occasions/')}
>
  <Header />

  <main id="main-content">
    <section class="relative overflow-hidden py-20 lg:py-28" style="background:linear-gradient(135deg,#fff7f0,#fef5ec);">
      <div class="absolute inset-0 pointer-events-none" style="background-image:radial-gradient(rgba(234,88,12,0.07) 1px,transparent 1px);background-size:32px 32px;" />
      <div class="relative mx-auto max-w-7xl px-6 text-center">
        <div class="badge-warm mb-6 inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-xs font-bold uppercase tracking-widest">
          {OCCASIONS.length}+ occasions
        </div>
        <h1 class="mb-4 font-black tracking-tight" style="font-size:clamp(2.5rem,6vw,4rem);color:var(--color-text);line-height:1.05;">
          Every celebration, covered
        </h1>
        <p class="mx-auto max-w-xl text-lg" style="color:var(--color-text-muted);">
          Pick your occasion, choose a template, personalize the text, and download your free PNG with no sign-up required.
        </p>
        <div class="mt-6 flex flex-wrap justify-center gap-3">
          <a href="/make/birthday/" class="rounded-full px-5 py-3 text-sm font-bold text-white" style="background:linear-gradient(135deg,#4F46E5,#7C3AED);">
            Start a new card
          </a>
          <a href="/drafts/" class="rounded-full px-5 py-3 text-sm font-bold" style="background:white;color:#1A1340;border:1px solid #DDD6FE;">
            Resume recent project
          </a>
        </div>
      </div>
    </section>

    <OccasionsGrid occasions={OCCASIONS} client:load />

    <section class="mx-auto max-w-7xl px-6 py-12" data-scroll>
      <div class="grid gap-6 lg:grid-cols-[1fr_1fr]">
        <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
          <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">How to choose the right occasion route</h2>
          <p class="mt-4 text-sm leading-relaxed" style="color:var(--color-text-muted);">
            This page is meant to help users reach the right invitation journey quickly, not force them through broad category browsing. If the event is clearly tied to a holiday, milestone, family gathering, or work function, the best move is to open the occasion that matches the real event first. From there, users can compare templates, refine wording, pick a printable or hosted format, and finish the invitation in fewer steps.
          </p>
        </div>

        <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
          <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">What makes this page useful instead of thin</h2>
          <ul class="mt-4 space-y-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">
            <li>It acts as a navigation hub into real invitation workflows, not a placeholder list of keywords.</li>
            <li>It supports global coverage across family events, holidays, festivals, and professional gatherings.</li>
            <li>It gives searchers a clear next click into templates, editors, wording pages, and event-specific hubs.</li>
          </ul>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
