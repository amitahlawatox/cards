---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CardEditor from '../../components/CardEditor';
import { OCCASIONS, getOccasionBySlug } from '../../lib/occasions';

export function getStaticPaths() {
  return OCCASIONS.map(occ => ({
    params: { occasion: occ.slug },
    props: { occ },
  }));
}

const { occ } = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "WebApplication",
  "name": `Free ${occ.name} Invitation Maker — CardCraftly`,
  "url": `https://www.cardcraftly.com/make/${occ.slug}/`,
  "description": occ.description,
  "applicationCategory": "UtilityApplication",
  "offers": { "@type": "Offer", "price": "0", "priceCurrency": "USD" }
};

// Related occasions (exclude current)
const related = OCCASIONS.filter(o => o.slug !== occ.slug).slice(0, 6);
---

<Layout
  title={`Free ${occ.name} Invitation Maker — Customize & Download | CardCraftly`}
  description={`${occ.description} Free ${occ.templates.length} templates. Customize text, fonts, download high-res PNG. No sign-up, no watermark.`}
  canonical={`https://www.cardcraftly.com/make/${occ.slug}/`}
  schema={schema}
>
  <Header />

  <main id="main-content" class="mx-auto max-w-6xl px-4 sm:px-6 py-10">

    <!-- Breadcrumb -->
    <nav class="mb-6 text-sm text-[var(--color-text-muted)]" aria-label="Breadcrumb">
      <ol class="flex items-center gap-2 flex-wrap">
        <li><a href="/" class="hover:text-pink-600 transition-colors">Home</a></li>
        <li aria-hidden="true">›</li>
        <li><a href="/occasions/" class="hover:text-pink-600 transition-colors">Occasions</a></li>
        <li aria-hidden="true">›</li>
        <li class="text-[var(--color-text)] font-medium">{occ.name}</li>
      </ol>
    </nav>

    <div class="mb-8">
      <div class="flex items-center gap-3 mb-2">
        <span class="text-4xl" aria-hidden="true">{occ.emoji}</span>
        <h1 class="text-3xl sm:text-4xl font-black">Free {occ.name} Invitation Maker</h1>
      </div>
      <p class="text-[var(--color-text-muted)] max-w-2xl">{occ.description} Pick a template, customize your text, and download your invitation for free.</p>
    </div>

    <!-- Top ad -->
    <div class="ad-slot mb-8 h-24" aria-hidden="true">Advertisement</div>

    <!-- Card editor -->
    <CardEditor client:load templates={occ.templates} occasionName={occ.name} />

    <!-- Tags / SEO keywords -->
    <div class="mt-10 flex flex-wrap gap-2" aria-label="Related searches">
      {occ.tags.map(tag => (
        <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-3 py-1.5 text-xs font-medium text-[var(--color-text-muted)]">
          {tag}
        </span>
      ))}
    </div>

    <!-- Related occasions -->
    <section class="mt-14" data-scroll>
      <h2 class="text-xl font-bold mb-5">More Occasions</h2>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-6 gap-3">
        {related.map(o => (
          <a href={`/make/${o.slug}/`}
            class="occasion-card rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-4 text-center hover:border-pink-300 transition-all group">
            <div class="text-3xl mb-2">{o.emoji}</div>
            <p class="text-xs font-semibold group-hover:text-pink-600 transition-colors">{o.name}</p>
          </a>
        ))}
      </div>
    </section>

    <!-- Bottom ad -->
    <div class="ad-slot mt-10 h-24" aria-hidden="true">Advertisement</div>

  </main>

  <Footer />
</Layout>
