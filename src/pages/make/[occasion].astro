---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import CanvasEditor from '../../components/CanvasEditor';
import FaqSection from '../../components/FaqSection.astro';
import OccasionContentNav from '../../components/OccasionContentNav.astro';
import OccasionTemplateGallery from '../../components/OccasionTemplateGallery.astro';
import { OCCASIONS } from '../../lib/occasions';
import {
  getOccasionChecklist,
  getOccasionFaqs,
  getOccasionMakerGrowthData,
  getOccasionPlanningTips,
  getOccasionRelated,
} from '../../lib/landing';
import { SITE, absoluteUrl } from '../../lib/site';
import { articleSchema, breadcrumbSchema, faqSchema } from '../../lib/seo';

export function getStaticPaths() {
  return OCCASIONS.map((occasion) => ({
    params: { occasion: occasion.slug },
    props: { occasion },
  }));
}

const { occasion } = Astro.props;
const related = getOccasionRelated(occasion, 6);
const faqs = getOccasionFaqs(occasion);
const checklist = getOccasionChecklist(occasion);
const planningTips = getOccasionPlanningTips(occasion);
const growthData = getOccasionMakerGrowthData(occasion);

const schema = [
  {
    '@context': 'https://schema.org',
    '@type': 'WebApplication',
    name: `Free ${occasion.name} Invitation Maker - ${SITE.name}`,
    url: absoluteUrl(`/make/${occasion.slug}/`),
    description: occasion.description,
    applicationCategory: 'UtilityApplication',
    offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  },
  articleSchema({
    title: growthData.title,
    description: growthData.metaDescription,
    path: `/make/${occasion.slug}/`,
  }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Occasions', path: '/occasions/' },
    { name: occasion.name, path: `/make/${occasion.slug}/` },
  ]),
  faqSchema(faqs),
];
---

<Layout
  title={growthData.title}
  description={growthData.metaDescription}
  canonical={absoluteUrl(`/make/${occasion.slug}/`)}
  schema={schema}
>
  <Header />

  <main id="main-content" class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <nav class="mb-6 text-sm text-[var(--color-text-muted)]" aria-label="Breadcrumb">
      <ol class="flex flex-wrap items-center gap-2">
        <li><a href="/" class="transition-colors hover:text-indigo-600">Home</a></li>
        <li aria-hidden="true">/</li>
        <li><a href="/occasions/" class="transition-colors hover:text-indigo-600">Occasions</a></li>
        <li aria-hidden="true">/</li>
        <li class="font-medium text-[var(--color-text)]">{occasion.name}</li>
      </ol>
    </nav>

    <section class="mb-8 grid gap-6 lg:grid-cols-[1.25fr_0.75fr] lg:items-start">
      <div>
        <div class="mb-2 flex items-center gap-3">
          <span class="text-4xl" aria-hidden="true">{occasion.emoji}</span>
          <h1 class="text-3xl font-black sm:text-4xl">Free {occasion.name} Invitation Maker</h1>
        </div>
        <p class="max-w-2xl text-[var(--color-text-muted)]">
          {growthData.intro}
        </p>
      </div>

      <aside class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
        <h2 class="text-lg font-bold" style="color:var(--color-text);">What to prepare</h2>
        <ul class="mt-4 space-y-3 text-sm" style="color:var(--color-text-muted);">
          {checklist.map((item) => (
            <li class="flex gap-3">
              <span class="mt-1 h-2 w-2 rounded-full bg-orange-400"></span>
              <span>{item}</span>
            </li>
          ))}
        </ul>
      </aside>
    </section>

    <CanvasEditor client:load templates={occasion.templates} occasionName={occasion.name} occasionSlug={occasion.slug} />

    <div class="mt-10 flex flex-wrap gap-2" aria-label="Related searches">
      {occasion.tags.map((tag) => (
        <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-3 py-1.5 text-xs font-medium text-[var(--color-text-muted)]">
          {tag}
        </span>
      ))}
    </div>

    <section class="mt-12 grid gap-5 md:grid-cols-3" data-scroll>
      {planningTips.map((tip, index) => (
        <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
          <p class="text-xs font-bold uppercase tracking-[0.22em]" style="color:#ea580c;">Tip {index + 1}</p>
          <p class="mt-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">{tip}</p>
        </div>
      ))}
    </section>

    <section class="mt-12 grid gap-5 md:grid-cols-3" data-scroll>
      {growthData.highlights.map((item, index) => (
        <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
          <p class="text-xs font-bold uppercase tracking-[0.22em]" style="color:#7C3AED;">Use case {index + 1}</p>
          <p class="mt-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">{item}</p>
        </div>
      ))}
    </section>

    <section class="mt-10" data-scroll>
      <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
        <h2 class="text-xl font-black" style="color:var(--color-text);">Searches this page is built to answer</h2>
        <div class="mt-4 flex flex-wrap gap-2">
          {growthData.searchTerms.map((term) => (
            <span class="rounded-full border border-[var(--color-border)] bg-[var(--color-surface)] px-3 py-1.5 text-xs font-semibold text-[var(--color-text-muted)]">
              {term}
            </span>
          ))}
        </div>
      </div>
    </section>

    <section class="mt-10" data-scroll>
      <h2 class="mb-5 text-2xl font-black tracking-tight" style="color:var(--color-text);">Best next pages for this {occasion.name.toLowerCase()} invite</h2>
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
        {growthData.routeSuggestions.map((route) => (
          <a href={route.href} class="rounded-3xl border p-6 transition-all hover:-translate-y-1" style="background:var(--color-surface);border-color:var(--color-border);">
            <h3 class="text-lg font-bold" style="color:var(--color-text);">{route.title}</h3>
            <p class="mt-2 text-sm leading-relaxed" style="color:var(--color-text-muted);">{route.description}</p>
          </a>
        ))}
      </div>
    </section>

    <OccasionContentNav occasion={occasion} />
    <OccasionTemplateGallery occasion={occasion} heading={`Popular ${occasion.name} templates`} limit={6} />
    <FaqSection title={`${occasion.name} invitation maker FAQ`} faqs={faqs} />

    <section class="mt-6" data-scroll>
      <h2 class="mb-5 text-xl font-bold">More occasions</h2>
      <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-6">
        {related.map((entry) => (
          <a
            href={`/make/${entry.slug}/`}
            class="occasion-card rounded-2xl border border-[var(--color-border)] bg-[var(--color-surface)] p-4 text-center transition-all hover:border-pink-300 group"
          >
            <div class="mb-2 text-3xl">{entry.emoji}</div>
            <p class="text-xs font-semibold transition-colors group-hover:text-indigo-600">{entry.name}</p>
          </a>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
