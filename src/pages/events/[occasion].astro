---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import OccasionContentNav from '../../components/OccasionContentNav.astro';
import OccasionTemplateGallery from '../../components/OccasionTemplateGallery.astro';
import { getFeaturedMicrositePaths } from '../../lib/content';
import {
  getOccasionChecklist,
  getOccasionFaqs,
  getOccasionMakerGrowthData,
  getOccasionPlanningTips,
  getOccasionWordingExamples,
} from '../../lib/landing';
import { SITE, absoluteUrl } from '../../lib/site';
import { articleSchema, breadcrumbSchema, faqSchema } from '../../lib/seo';

export function getStaticPaths() {
  return getFeaturedMicrositePaths();
}

const { occasion } = Astro.props;
const path = `/events/${occasion.slug}/`;
const description = `A focused event microsite for ${occasion.name.toLowerCase()} invitation searchers, with templates, wording flows, and hosted invite entry points.`;
const growthData = getOccasionMakerGrowthData(occasion);
const checklist = getOccasionChecklist(occasion);
const faqs = getOccasionFaqs(occasion);
const wordingExamples = getOccasionWordingExamples(occasion).slice(0, 3);
const planningTips = getOccasionPlanningTips(occasion);
const schema = [
  articleSchema({ title: `${occasion.name} Event Microsite | ${SITE.name}`, description, path }),
  faqSchema(faqs),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Events', path: '/events/' },
    { name: occasion.name, path },
  ]),
];
---

<Layout title={`${occasion.name} Event Microsite | ${SITE.name}`} description={description} canonical={absoluteUrl(path)} schema={schema}>
  <Header />
  <main id="main-content" class="mx-auto max-w-6xl px-6 py-12">
    <div class="rounded-[2rem] border px-8 py-10" style="background:linear-gradient(135deg,#eff6ff,#fdf2f8);border-color:#C4B5FD;">
      <p class="text-sm font-bold uppercase tracking-[0.24em]" style="color:#7C3AED;">Event microsite</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight" style="color:#1A1340;">{occasion.name} invitations, templates, and hosted invite tools</h1>
      <p class="mt-4 max-w-4xl text-lg leading-relaxed" style="color:#6B63A3;">{growthData.intro}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={`/make/${occasion.slug}/`} class="rounded-full px-5 py-3 text-sm font-bold text-white" style="background:linear-gradient(135deg,#4F46E5,#7C3AED);">
          Start this event invitation
        </a>
        <a href={`/templates/${occasion.slug}/`} class="rounded-full px-5 py-3 text-sm font-bold" style="background:var(--color-surface);color:var(--color-text);border:1px solid var(--color-border);">
          Compare templates
        </a>
      </div>
    </div>

    <section class="py-10" data-scroll>
      <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">Common searches behind this event microsite</h2>
      <div class="mt-5 flex flex-wrap gap-3">
        {growthData.searchTerms.map((term) => (
          <span class="rounded-full border px-4 py-2 text-sm font-semibold" style="background:var(--color-surface);border-color:var(--color-border);color:var(--color-text-muted);">
            {term}
          </span>
        ))}
      </div>
    </section>

    <section class="grid gap-6 py-4 lg:grid-cols-[0.9fr_1.1fr]" data-scroll>
      <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
        <p class="text-xs font-bold uppercase tracking-[0.22em]" style="color:#ea580c;">Planning checklist</p>
        <h2 class="mt-3 text-2xl font-black tracking-tight" style="color:var(--color-text);">What most hosts need before they share the invite</h2>
        <div class="mt-5 space-y-3">
          {checklist.map((item) => (
            <div class="rounded-2xl px-4 py-3" style="background:rgba(79,70,229,0.05);">
              <p class="text-sm leading-relaxed" style="color:var(--color-text-muted);">{item}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
        <p class="text-xs font-bold uppercase tracking-[0.22em]" style="color:#ea580c;">Internal linking</p>
        <h2 class="mt-3 text-2xl font-black tracking-tight" style="color:var(--color-text);">Best next pages for {occasion.name.toLowerCase()} searchers</h2>
        <div class="mt-5 grid gap-4 md:grid-cols-2">
          {growthData.routeSuggestions.map((link) => (
            <a href={link.href} class="rounded-3xl border p-5 transition-all hover:-translate-y-1" style="background:var(--color-surface-2);border-color:var(--color-border);">
              <h3 class="text-base font-black" style="color:var(--color-text);">{link.title}</h3>
              <p class="mt-2 text-sm leading-relaxed" style="color:var(--color-text-muted);">{link.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section class="grid gap-6 py-10 lg:grid-cols-2" data-scroll>
      <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
        <p class="text-xs font-bold uppercase tracking-[0.22em]" style="color:#ea580c;">Wording help</p>
        <h2 class="mt-3 text-2xl font-black tracking-tight" style="color:var(--color-text);">Useful {occasion.name.toLowerCase()} wording examples</h2>
        <div class="mt-5 space-y-4">
          {wordingExamples.map((example) => (
            <div class="rounded-2xl px-4 py-4" style="background:rgba(234,88,12,0.05);">
              <h3 class="text-base font-black" style="color:var(--color-text);">{example.title}</h3>
              <p class="mt-2 text-sm leading-relaxed" style="color:var(--color-text-muted);">{example.body}</p>
            </div>
          ))}
        </div>
      </div>

      <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
        <p class="text-xs font-bold uppercase tracking-[0.22em]" style="color:#ea580c;">Host guidance</p>
        <h2 class="mt-3 text-2xl font-black tracking-tight" style="color:var(--color-text);">Planning tips that improve conversion</h2>
        <div class="mt-5 space-y-4">
          {planningTips.map((tip) => (
            <div class="rounded-2xl px-4 py-4" style="background:rgba(79,70,229,0.05);">
              <p class="text-sm leading-relaxed" style="color:var(--color-text-muted);">{tip}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <OccasionTemplateGallery occasion={occasion} heading={`${occasion.name} event templates`} limit={6} linkMode="detail" />
    <OccasionContentNav occasion={occasion} title={`Everything you need for a ${occasion.name.toLowerCase()} event page`} />

    <section class="mx-auto max-w-4xl px-6 py-10" data-scroll>
      <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">{occasion.name} invitation FAQ</h2>
      <div class="mt-6 space-y-4">
        {faqs.map((faq) => (
          <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
            <h3 class="text-lg font-black" style="color:var(--color-text);">{faq.question}</h3>
            <p class="mt-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">{faq.answer}</p>
          </div>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>
