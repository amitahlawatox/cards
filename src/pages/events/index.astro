---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { FEATURED_EVENT_MICROSITES, getOccasionBySlug } from '../../lib/content';
import type { Occasion } from '../../lib/occasions';
import { SITE, absoluteUrl } from '../../lib/site';
import { articleSchema, breadcrumbSchema } from '../../lib/seo';

const occasions = FEATURED_EVENT_MICROSITES.map((slug) => getOccasionBySlug(slug)).filter((occasion): occasion is Occasion => Boolean(occasion));
const path = '/events/';
const title = `Event Microsites | ${SITE.name}`;
const description = 'Focused invitation hubs for weddings, birthdays, baby showers, and corporate events with templates, wording, and hosted invite flows.';
const schema = [
  articleSchema({ title, description, path }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Events', path },
  ]),
];
---

<Layout title={title} description={description} canonical={absoluteUrl(path)} schema={schema}>
  <Header />
  <main id="main-content" class="mx-auto max-w-7xl px-6 py-12">
    <div class="rounded-[2rem] border px-8 py-10" style="background:linear-gradient(135deg,#eef2ff,#fff7ed);border-color:#C4B5FD;">
      <p class="text-sm font-bold uppercase tracking-[0.24em]" style="color:#7C3AED;">Event hub</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight" style="color:#1A1340;">Invitation microsites by event category</h1>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed" style="color:#6B63A3;">
        Explore event-specific pages that guide you from an invitation idea to a useful page you can share with guests.
      </p>
    </div>

    <section class="mt-10 grid gap-5 md:grid-cols-2 xl:grid-cols-4" data-scroll>
      {occasions.map((occasion) => (
        <a href={`/events/${occasion.slug}/`} class="rounded-3xl border p-6 transition-all hover:-translate-y-1" style="background:var(--color-surface);border-color:var(--color-border);">
          <p class="text-3xl">{occasion.emoji}</p>
          <h2 class="mt-4 text-xl font-black" style="color:var(--color-text);">{occasion.name}</h2>
          <p class="mt-2 text-sm leading-relaxed" style="color:var(--color-text-muted);">{occasion.description}</p>
        </a>
        ))}
      </section>

    <section class="mt-10 grid gap-6 lg:grid-cols-[1fr_1fr]" data-scroll>
      <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
        <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">What makes a microsite useful</h2>
        <p class="mt-4 text-sm leading-relaxed" style="color:var(--color-text-muted);">
          Event microsites are meant for categories where the visitor usually needs more than a simple card gallery. Weddings, birthdays, baby showers, and corporate events often require wording help, planning prompts, template comparison, and a clearer path into hosted invite tools.
        </p>
        <p class="mt-4 text-sm leading-relaxed" style="color:var(--color-text-muted);">
          Instead of forcing those users through disconnected pages, each microsite groups the strongest next actions into one route so they can move from search to template choice to editor use with less friction.
        </p>
      </div>

      <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
        <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">When to open a microsite instead of a normal occasion page</h2>
        <ul class="mt-4 space-y-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">
          <li>When the event needs RSVP, schedule, or guest-planning help in addition to a design.</li>
          <li>When the user is comparing workflows instead of only browsing templates.</li>
          <li>When you want related planning, wording, and design help in one place.</li>
        </ul>
      </div>
    </section>

    <section class="mt-10 rounded-3xl border p-6" data-scroll style="background:var(--color-surface);border-color:var(--color-border);">
      <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">How these pages fit the rest of the site</h2>
      <p class="mt-4 text-sm leading-relaxed" style="color:var(--color-text-muted);">
        These event guides sit between broad occasion pages and the editor. Each one brings templates, wording examples, RSVP help, schedule guidance, and hosted-invite tasks together so you do not have to follow disconnected pages.
      </p>
    </section>

    <section class="mt-10 grid gap-6 lg:grid-cols-[1fr_1fr]" data-scroll>
      <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
        <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">What a high-quality event page should answer</h2>
        <ul class="mt-4 space-y-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">
          <li>Which template styles make sense for the event and guest mix.</li>
          <li>Whether the card alone is enough or the event needs RSVP, schedule, and hosted details.</li>
          <li>Which wording, printable, or sharing route should come next.</li>
        </ul>
      </div>

      <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
        <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">Why this improves search quality</h2>
        <p class="mt-4 text-sm leading-relaxed" style="color:var(--color-text-muted);">
          Microsites give us room to publish denser, more useful content around high-value events instead of spinning out shallow pages for every modifier. That keeps the site architecture cleaner for users and stronger for search because each indexed page has a clearer job, better internal links, and a more complete path into the actual invitation product.
        </p>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
