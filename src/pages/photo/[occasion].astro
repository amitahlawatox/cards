---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import OccasionTemplateGallery from '../../components/OccasionTemplateGallery.astro';
import OccasionContentNav from '../../components/OccasionContentNav.astro';
import { getOccasionFaqs, getOccasionPlanningTips, getOccasionWordingExamples } from '../../lib/landing';
import {
  getPhotoOccasionPaths,
  getPhotoPageDescription,
  getPhotoPageHighlights,
  getPhotoPageQueries,
  getPhotoRouteSuggestions,
} from '../../lib/content';
import { SITE, absoluteUrl } from '../../lib/site';
import { articleSchema, breadcrumbSchema, faqSchema } from '../../lib/seo';

export function getStaticPaths() {
  return getPhotoOccasionPaths();
}

const { occasion } = Astro.props;
const path = `/photo/${occasion.slug}/`;
const description = getPhotoPageDescription(occasion);
const highlights = getPhotoPageHighlights(occasion);
const queries = getPhotoPageQueries(occasion);
const routeSuggestions = getPhotoRouteSuggestions(occasion);
const wordingExamples = getOccasionWordingExamples(occasion).slice(0, 2);
const planningTips = getOccasionPlanningTips(occasion);
const faqs = getOccasionFaqs(occasion);
const schema = [
  articleSchema({ title: `${occasion.name} Photo Invitation Maker | ${SITE.name}`, description, path }),
  faqSchema(faqs),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Photo Invitations', path: '/photo/' },
    { name: occasion.name, path },
  ]),
];
---

<Layout title={`${occasion.name} Photo Invitation Maker | ${SITE.name}`} description={description} canonical={absoluteUrl(path)} schema={schema}>
  <Header />
  <main id="main-content" class="mx-auto max-w-6xl px-6 py-12">
    <div class="rounded-[2rem] border px-8 py-10" style="background:linear-gradient(135deg,#ecfeff,#fef3c7);border-color:#BFDBFE;">
      <p class="text-sm font-bold uppercase tracking-[0.24em]" style="color:#0f766e;">Photo-focused page</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight" style="color:#1A1340;">{occasion.name} photo invitations and card maker tips</h1>
      <p class="mt-4 max-w-4xl text-lg leading-relaxed" style="color:#6B63A3;">{description}</p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href={`/make/${occasion.slug}/?focus=photo`} class="rounded-full px-5 py-3 text-sm font-bold text-white" style="background:linear-gradient(135deg,#4F46E5,#7C3AED);">
          Start a photo {occasion.name.toLowerCase()} card
        </a>
        <a href="/features/photo-card-maker/" class="rounded-full px-5 py-3 text-sm font-bold" style="background:var(--color-surface);color:var(--color-text);border:1px solid var(--color-border);">
          See all photo-card features
        </a>
      </div>
    </div>

    <section class="mt-10 grid gap-5 md:grid-cols-3" data-scroll>
      {highlights.map((highlight, index) => (
        <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
          <p class="text-xs font-bold uppercase tracking-[0.22em]" style="color:#ea580c;">Photo benefit {index + 1}</p>
          <p class="mt-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">{highlight}</p>
        </div>
      ))}
    </section>

    <section class="mt-10 grid gap-6 lg:grid-cols-2" data-scroll>
      <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
        <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">Common searches behind photo invitations</h2>
        <div class="mt-5 flex flex-wrap gap-3">
          {queries.map((query) => (
            <span class="rounded-full border px-4 py-2 text-sm font-semibold" style="background:var(--color-surface-2);border-color:var(--color-border);color:var(--color-text-muted);">
              {query}
            </span>
          ))}
        </div>
      </div>

      <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
        <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">Short copy styles that work with photo cards</h2>
        <div class="mt-5 space-y-4">
          {wordingExamples.map((example) => (
            <div class="rounded-2xl px-4 py-4" style="background:rgba(79,70,229,0.05);">
              <h3 class="text-base font-black" style="color:var(--color-text);">{example.title}</h3>
              <p class="mt-2 text-sm leading-relaxed" style="color:var(--color-text-muted);">{example.body}</p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="mt-10" data-scroll>
      <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">Best next pages for a photo-first invite journey</h2>
      <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        {routeSuggestions.map((link) => (
          <a href={link.href} class="rounded-3xl border p-6 transition-all hover:-translate-y-1" style="background:var(--color-surface);border-color:var(--color-border);">
            <h3 class="text-lg font-black" style="color:var(--color-text);">{link.title}</h3>
            <p class="mt-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">{link.description}</p>
          </a>
        ))}
      </div>
    </section>

    <OccasionTemplateGallery occasion={occasion} heading={`${occasion.name} templates that pair well with photos`} intro={`Compare ${occasion.name.toLowerCase()} layouts that can support one strong image plus the key guest-facing details.`} limit={6} linkMode="detail" />

    <section class="grid gap-5 md:grid-cols-3" data-scroll>
      {planningTips.map((tip, index) => (
        <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
          <p class="text-xs font-bold uppercase tracking-[0.22em]" style="color:#7C3AED;">Photo tip {index + 1}</p>
          <p class="mt-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">{tip}</p>
        </div>
      ))}
    </section>

    <OccasionContentNav occasion={occasion} title={`Keep exploring ${occasion.name.toLowerCase()} invite resources`} />

    <section class="mx-auto max-w-4xl px-6 py-10" data-scroll>
      <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">{occasion.name} photo invitation FAQ</h2>
      <div class="mt-6 space-y-4">
        {faqs.map((faq) => (
          <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
            <h3 class="text-lg font-black" style="color:var(--color-text);">{faq.question}</h3>
            <p class="mt-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">{faq.answer}</p>
          </div>
        ))}
      </div>
    </section>
  </main>
  <Footer />
</Layout>
