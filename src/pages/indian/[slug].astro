---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { getMarketClusterBySlug, getOccasionsBySlugs, MARKET_CLUSTERS } from '../../lib/content';
import { SITE, absoluteUrl } from '../../lib/site';
import { articleSchema, breadcrumbSchema } from '../../lib/seo';

export function getStaticPaths() {
  return MARKET_CLUSTERS.map((cluster) => ({ params: { slug: cluster.slug }, props: { cluster } }));
}

const { cluster } = Astro.props;
const occasions = getOccasionsBySlugs(cluster.occasionSlugs);
const path = `/indian/${cluster.slug}/`;
const occasionNames = occasions.map((occasion) => occasion.name).join(', ');
const schema = [
  articleSchema({ title: `${cluster.title} | ${SITE.name}`, description: cluster.description, path }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Indian Clusters', path: '/indian/' },
    { name: cluster.title, path },
  ]),
];
---

<Layout title={`${cluster.title} | ${SITE.name}`} description={cluster.description} canonical={absoluteUrl(path)} schema={schema}>
  <Header />
  <main id="main-content" class="mx-auto max-w-7xl px-6 py-12">
    <div class="rounded-[2rem] border px-8 py-10" style="background:linear-gradient(135deg,#fff7ed,#fffbeb);border-color:#FDBA74;">
      <p class="text-sm font-bold uppercase tracking-[0.24em]" style="color:#d97706;">Market cluster</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight" style="color:#1A1340;">{cluster.title}</h1>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed" style="color:#6B63A3;">{cluster.description}</p>
    </div>

    <section class="mt-10 grid gap-5 md:grid-cols-3" data-scroll>
      {cluster.highlights.map((highlight) => (
        <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
          <p class="text-sm leading-relaxed" style="color:var(--color-text-muted);">{highlight}</p>
        </div>
      ))}
    </section>

    <section class="mx-auto py-10" data-scroll>
      <div class="grid gap-6 lg:grid-cols-[1fr_1fr]">
        <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
          <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">Why this market cluster matters</h2>
          <p class="mt-4 text-sm leading-relaxed" style="color:var(--color-text-muted);">
            Indian invitation demand often combines cultural tone, family-hosted events, practical schedule details, and sharing preferences like WhatsApp in a single search journey. That makes these pages more useful when they connect related event types instead of forcing each page to stand alone.
          </p>
          <p class="mt-4 text-sm leading-relaxed" style="color:var(--color-text-muted);">
            This cluster brings together {occasionNames.toLowerCase()} so visitors can move between festive events, family celebrations, and more formal invitation needs without losing the cultural or guest-sharing context that matters.
          </p>
        </div>

        <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
          <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">Best way to use this cluster</h2>
          <ul class="mt-4 space-y-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">
            <li>Start with the event type closest to your actual ceremony, family gathering, or festive host plan.</li>
            <li>Use the Indian-specific route when tone, family naming, or sharing format matters more than generic template style.</li>
            <li>Move to wording or hosted invite help when one card cannot carry all the guest details comfortably.</li>
          </ul>
        </div>
      </div>
    </section>

    <section class="mx-auto py-10" data-scroll>
      <h2 class="mb-5 text-2xl font-black tracking-tight" style="color:var(--color-text);">Pages in this cluster</h2>
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        {occasions.map((occasion) => (
          <a href={`/invitations/${occasion.slug}/`} class="rounded-3xl border p-6 transition-all hover:-translate-y-1" style="background:var(--color-surface);border-color:var(--color-border);">
            <p class="text-3xl">{occasion.emoji}</p>
            <h3 class="mt-4 text-lg font-black" style="color:var(--color-text);">{occasion.name} invitation hub</h3>
            <p class="mt-2 text-sm leading-relaxed" style="color:var(--color-text-muted);">Browse templates, wording, sharing options, and planning help for {occasion.description.toLowerCase()}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="mx-auto py-10" data-scroll>
      <div class="grid gap-6 lg:grid-cols-[1fr_1fr]">
        <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
          <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">Common details these events often need</h2>
          <p class="mt-4 text-sm leading-relaxed" style="color:var(--color-text-muted);">
            Many family and festive invitations in this cluster need more than a title and a date. Guests may need ceremony sequence, who is hosting, whether the event is traditional or modern in tone, what should be shared on WhatsApp, and which details belong on a hosted invite page rather than the card itself. That is why these cluster routes connect invitation templates to wording help and practical next steps instead of repeating one generic cultural paragraph across multiple pages.
          </p>
        </div>

        <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
          <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">How this cluster stays useful</h2>
          <ul class="mt-4 space-y-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">
            <li>It helps visitors move from search intent into a real invitation workflow instead of leaving them on a summary page.</li>
            <li>It keeps family, festive, and hosted-invite needs connected when one card cannot carry every guest detail clearly.</li>
            <li>It supports printable, WhatsApp, wording, and hosted routes without splintering the topic into doorway-style pages.</li>
          </ul>
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
