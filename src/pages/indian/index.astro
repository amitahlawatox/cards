---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { MARKET_CLUSTERS } from '../../lib/content';
import { SITE, absoluteUrl } from '../../lib/site';
import { articleSchema, breadcrumbSchema } from '../../lib/seo';

const path = '/indian/';
const title = `Indian Invitation Ideas | ${SITE.name}`;
const description = 'Indian invitation ideas for festive, family, wedding, and hosted events, with culture-aware wording, templates, and sharing options.';
const schema = [
  articleSchema({ title, description, path }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Indian Clusters', path },
  ]),
];
---

<Layout title={title} description={description} canonical={absoluteUrl(path)} schema={schema}>
  <Header />
  <main id="main-content" class="mx-auto max-w-7xl px-6 py-12">
    <div class="rounded-[2rem] border px-8 py-10" style="background:linear-gradient(135deg,#fff7ed,#fffbeb);border-color:#FDBA74;">
      <p class="text-sm font-bold uppercase tracking-[0.24em]" style="color:#d97706;">Market hub</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight" style="color:#1A1340;">Indian festive and family invitation clusters</h1>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed" style="color:#6B63A3;">
        Browse targeted pages built around Indian festive, family-event, and WhatsApp-friendly invitation intent.
      </p>
      <div class="mt-6 flex flex-wrap gap-3">
        <a href="/compare/indian-wedding-invitation-maker/" class="rounded-full px-5 py-3 text-sm font-bold text-white" style="background:linear-gradient(135deg,#d97706,#ea580c);">
          Indian wedding invitation maker
        </a>
        <a href="/guides/indian-wedding-invitation-wording/" class="rounded-full px-5 py-3 text-sm font-bold" style="background:var(--color-surface);color:var(--color-text);border:1px solid var(--color-border);">
          Indian wedding wording guide
        </a>
      </div>
    </div>

    <section class="mt-10 grid gap-5 md:grid-cols-2" data-scroll>
      {MARKET_CLUSTERS.map((cluster) => (
        <a href={`/indian/${cluster.slug}/`} class="rounded-3xl border p-6 transition-all hover:-translate-y-1" style="background:var(--color-surface);border-color:var(--color-border);">
          <p class="text-xs font-bold uppercase tracking-[0.22em]" style="color:#d97706;">Cluster</p>
          <h2 class="mt-3 text-2xl font-black" style="color:var(--color-text);">{cluster.title}</h2>
          <p class="mt-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">{cluster.description}</p>
        </a>
      ))}
    </section>

    <section class="mt-10 grid gap-6 lg:grid-cols-[1fr_1fr]" data-scroll>
      <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
        <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">Why these Indian invitation guides exist</h2>
        <p class="mt-4 text-sm leading-relaxed" style="color:var(--color-text-muted);">
          Some invitation searches carry extra expectations around family structure, festive tone, event sequence, and sharing habits. This market hub groups the pages where those expectations matter most so users do not have to translate a generic invitation route into a family or festival context by themselves.
        </p>
      </div>

      <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
        <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">Use this hub when</h2>
        <ul class="mt-4 space-y-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">
          <li>The invitation needs Indian festive, family, or ceremony-specific wording.</li>
          <li>WhatsApp sharing, multi-event details, or family-hosted tone matter more than generic style labels.</li>
          <li>You want a fast route from cultural inspiration to a usable template or wording page.</li>
        </ul>
      </div>
    </section>

    <section class="mt-10 rounded-3xl border p-6" data-scroll style="background:var(--color-surface);border-color:var(--color-border);">
      <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">What these cluster pages are meant to do</h2>
      <p class="mt-4 text-sm leading-relaxed" style="color:var(--color-text-muted);">
        These guides connect cultural context to a real invitation outcome. They help you move from a festive or family-event idea into templates, wording help, sharing-friendly formats, and hosted invite flows that match the event structure you need.
      </p>
      <p class="mt-4 text-sm leading-relaxed" style="color:var(--color-text-muted);">
        This approach supports culture-aware invitation needs while keeping each page useful, distinct, and easy to navigate.
      </p>
    </section>

    <section class="mt-10 grid gap-6 lg:grid-cols-[1fr_1fr]" data-scroll>
      <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
        <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">How this hub fits a global site</h2>
        <p class="mt-4 text-sm leading-relaxed" style="color:var(--color-text-muted);">
          This market section is not meant to narrow the brand. It exists because some invitation tasks carry distinct expectations around family structure, ceremony sequence, and sharing format. Treating those needs directly makes the site more useful for those users while keeping the wider .com architecture strong for other markets, festivals, and family-event journeys.
        </p>
      </div>

      <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
        <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">What we avoid on market pages</h2>
        <ul class="mt-4 space-y-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">
          <li>Thin pages that only add a market label without changing the invitation guidance.</li>
          <li>Doorway-style routes that repeat the same copy with minor keyword swaps.</li>
          <li>Dead-end pages that fail to connect users to templates, wording help, and real sharing workflows.</li>
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
