---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { SEASONAL_HUBS } from '../../lib/content';
import { SITE, absoluteUrl } from '../../lib/site';
import { articleSchema, breadcrumbSchema } from '../../lib/seo';

const schema = [
  articleSchema({
    title: `Seasonal Invitation Hubs | ${SITE.name}`,
    description: 'Seasonal invitation hubs for Fourth of July, Thanksgiving, Easter, European festivals, Diwali, Christmas, New Year, and more.',
    path: '/seasonal/',
  }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Seasonal', path: '/seasonal/' },
  ]),
];
---

<Layout title={`Seasonal Invitation Hubs | ${SITE.name}`} description="Seasonal invitation hubs for Fourth of July, Thanksgiving, Easter, European festivals, Diwali, Christmas, New Year, and more." canonical={absoluteUrl('/seasonal/')} schema={schema}>
  <Header />

  <main id="main-content" class="mx-auto max-w-7xl px-6 py-12">
    <div class="mb-10 max-w-3xl">
      <p class="text-sm font-bold uppercase tracking-[0.24em]" style="color:#ea580c;">Seasonal search</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight" style="color:var(--color-text);">Seasonal invitation hubs</h1>
      <p class="mt-3 text-base leading-relaxed" style="color:var(--color-text-muted);">These hubs group the occasions and guides most likely to surge together during holiday, festival, and event-season demand windows across major global markets.</p>
    </div>

    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3">
      {SEASONAL_HUBS.map((hub) => (
        <a href={`/seasonal/${hub.slug}/`} class="rounded-3xl border p-6 transition-all hover:-translate-y-1" style="background:var(--color-surface);border-color:var(--color-border);">
          <h2 class="text-xl font-black" style="color:var(--color-text);">{hub.title}</h2>
          <p class="mt-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">{hub.description}</p>
        </a>
      ))}
    </div>

    <section class="mt-10 grid gap-6 lg:grid-cols-[1fr_1fr]" data-scroll>
      <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
        <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">How seasonal demand behaves</h2>
        <p class="mt-4 text-sm leading-relaxed" style="color:var(--color-text-muted);">
          Seasonal invitation searches rise quickly and often come from users who are closer to action than broad evergreen searchers. They usually want a ready-made route that combines templates, wording, and sharing help without extra digging.
        </p>
        <p class="mt-4 text-sm leading-relaxed" style="color:var(--color-text-muted);">
          These hubs exist to group the strongest related pages together so visitors can stay inside one event window and complete the task faster.
        </p>
      </div>

      <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
        <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">Best use for this page</h2>
        <ul class="mt-4 space-y-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">
          <li>Choose the seasonal cluster that matches the actual hosting window.</li>
          <li>Use the hub when you are comparing related occasions, not just one template.</li>
          <li>Move from the cluster into the exact occasion page once the event direction is clear.</li>
        </ul>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
