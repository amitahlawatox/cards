---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { COMPARISON_PAGES } from '../../lib/content';
import { SITE, absoluteUrl } from '../../lib/site';
import { articleSchema, breadcrumbSchema } from '../../lib/seo';

const path = '/compare/';
const title = `Invitation Maker Comparisons | ${SITE.name}`;
const description = 'Comparison pages for free invitation makers, Canva alternatives, Evite alternatives, printable Diwali templates, Indian wedding invites, and online RSVP invitations.';
const schema = [
  articleSchema({ title, description, path }),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Comparisons', path },
  ]),
];
---

<Layout title={title} description={description} canonical={absoluteUrl(path)} schema={schema}>
  <Header />
  <main id="main-content" class="mx-auto max-w-7xl px-6 py-12">
    <div class="rounded-[2rem] border px-8 py-10" style="background:linear-gradient(135deg,#eef2ff,#fff7ed);border-color:#C4B5FD;">
      <p class="text-sm font-bold uppercase tracking-[0.24em]" style="color:#7C3AED;">Comparison hub</p>
      <h1 class="mt-3 text-4xl font-black tracking-tight" style="color:#1A1340;">Comparison pages built for choice-stage invitation search intent</h1>
      <p class="mt-4 max-w-4xl text-lg leading-relaxed" style="color:#6B63A3;">
        These pages target users comparing invitation tools, RSVP workflows, printable formats, and market-specific use cases right before they pick a platform.
      </p>
    </div>

    <section class="mt-10 grid gap-6 md:grid-cols-2 xl:grid-cols-3" data-scroll>
      {COMPARISON_PAGES.map((page) => (
        <a href={`/compare/${page.slug}/`} class="rounded-3xl border p-6 transition-all hover:-translate-y-1" style="background:var(--color-surface);border-color:var(--color-border);">
          <p class="text-xs font-bold uppercase tracking-[0.22em]" style="color:#ea580c;">Comparison page</p>
          <h2 class="mt-3 text-2xl font-black" style="color:var(--color-text);">{page.title}</h2>
          <p class="mt-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">{page.description}</p>
        </a>
      ))}
    </section>

    <section class="mt-10 grid gap-6 lg:grid-cols-[1fr_1fr]" data-scroll>
      <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
        <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">Why comparison pages exist</h2>
        <p class="mt-4 text-sm leading-relaxed" style="color:var(--color-text-muted);">
          These pages are for visitors who are already close to choosing a platform. They are not generic list posts. The goal is to connect tool-comparison intent to the specific strengths of the site, such as faster invite creation, better occasion focus, printable workflows, or hosted RSVP support.
        </p>
      </div>

      <div class="rounded-3xl border p-6" style="background:var(--color-surface);border-color:var(--color-border);">
        <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">How to use the comparison hub</h2>
        <ul class="mt-4 space-y-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">
          <li>Open the page closest to the tool or workflow you are comparing.</li>
          <li>Check whether the route connects directly to a usable invitation flow, not just surface-level feature claims.</li>
          <li>Move into the linked occasion or feature page once the product fit feels clear.</li>
        </ul>
      </div>
    </section>
  </main>
  <Footer />
</Layout>
