---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import HeroSection from '../components/HeroSection';
import OccasionsGrid from '../components/OccasionsGrid';
import FeaturesSection from '../components/FeaturesSection';
import HowItWorksSection from '../components/HowItWorksSection';
import { OCCASIONS } from '../lib/occasions';
import { SITE, absoluteUrl } from '../lib/site';
import { COMPARISON_PAGES, GUIDE_PAGES, MARKET_CLUSTERS, PRODUCT_FEATURE_PAGES, SEASONAL_HUBS } from '../lib/content';

const schema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: `${SITE.name} - Free Invitation and Greeting Card Maker`,
  url: SITE.domain,
  description: SITE.defaultDescription,
  applicationCategory: 'UtilityApplication',
  operatingSystem: 'Any',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
};
---

<Layout
  title={SITE.defaultTitle}
  description={SITE.defaultDescription}
  canonical={absoluteUrl('/')}
  schema={schema}
>
  <script is:inline>document.body.dataset.homepage = 'true';</script>
  <Header />

  <main id="main-content">
    <HeroSection client:load />
    <OccasionsGrid occasions={OCCASIONS} client:load />
    <HowItWorksSection client:visible />
    <FeaturesSection client:visible />

    <section class="mx-auto max-w-7xl px-6 py-16" data-scroll>
      <div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.24em]" style="color:#7C3AED;">Product intent pages</p>
          <h2 class="text-3xl font-black tracking-tight" style="color:var(--color-text);">Explore the features people are already searching for</h2>
        </div>
        <a href="/features/" class="text-sm font-bold" style="color:#ea580c;">See all feature pages</a>
      </div>

      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-4">
        {PRODUCT_FEATURE_PAGES.slice(0, 4).map((feature) => (
          <a href={`/features/${feature.slug}/`} class="rounded-[2rem] border p-6 transition-all hover:-translate-y-1" style="background:var(--color-surface);border-color:var(--color-border);">
            <p class="text-xs font-bold uppercase tracking-[0.22em]" style="color:#ea580c;">Feature</p>
            <h3 class="mt-3 text-2xl font-black" style="color:#1A1340;">{feature.title}</h3>
            <p class="mt-3 text-sm leading-relaxed" style="color:#6B63A3;">{feature.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 py-16" data-scroll>
      <div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.24em]" style="color:#ea580c;">Choice-stage SEO</p>
          <h2 class="text-3xl font-black tracking-tight" style="color:var(--color-text);">Compare invitation tools, workflows, and high-intent use cases</h2>
        </div>
        <a href="/compare/" class="text-sm font-bold" style="color:#7C3AED;">See all comparison pages</a>
      </div>

      <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
        {COMPARISON_PAGES.slice(0, 3).map((page) => (
          <a href={`/compare/${page.slug}/`} class="rounded-[2rem] border p-6 transition-all hover:-translate-y-1" style="background:var(--color-surface);border-color:var(--color-border);">
            <p class="text-xs font-bold uppercase tracking-[0.22em]" style="color:#ea580c;">Comparison</p>
            <h3 class="mt-3 text-2xl font-black" style="color:#1A1340;">{page.title}</h3>
            <p class="mt-3 text-sm leading-relaxed" style="color:#6B63A3;">{page.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section class="mx-auto max-w-7xl px-6 py-16" data-scroll>
      <div class="mb-8 flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div>
          <p class="text-sm font-bold uppercase tracking-[0.24em]" style="color:#ea580c;">SEO growth hubs</p>
          <h2 class="text-3xl font-black tracking-tight" style="color:var(--color-text);">Browse seasonal, editorial, and market-specific paths</h2>
        </div>
        <a href="/seasonal/" class="text-sm font-bold" style="color:#7C3AED;">See all content hubs</a>
      </div>

      <div class="grid gap-6 lg:grid-cols-3">
        <div class="rounded-[2rem] border p-7" style="background:linear-gradient(135deg,#fff7ed,#fff1f2);border-color:#FDBA74;">
          <p class="text-xs font-bold uppercase tracking-[0.24em]" style="color:#ea580c;">Seasonal</p>
          <h3 class="mt-3 text-2xl font-black" style="color:#1A1340;">Holiday and event-season clusters</h3>
          <div class="mt-5 space-y-3">
            {SEASONAL_HUBS.slice(0, 3).map((hub) => (
              <a href={`/seasonal/${hub.slug}/`} class="block rounded-2xl border px-4 py-3 text-sm font-semibold transition-all hover:-translate-y-0.5" style="background:rgba(255,255,255,0.72);border-color:rgba(255,255,255,0.6);color:#6B63A3;">
                {hub.title}
              </a>
            ))}
          </div>
        </div>

        <div class="rounded-[2rem] border p-7" style="background:linear-gradient(135deg,#eef2ff,#f5f3ff);border-color:#C4B5FD;">
          <p class="text-xs font-bold uppercase tracking-[0.24em]" style="color:#7C3AED;">Editorial</p>
          <h3 class="mt-3 text-2xl font-black" style="color:#1A1340;">Helpful invitation wording guides</h3>
          <div class="mt-5 space-y-3">
            {GUIDE_PAGES.slice(0, 3).map((guide) => (
              <a href={`/guides/${guide.slug}/`} class="block rounded-2xl border px-4 py-3 text-sm font-semibold transition-all hover:-translate-y-0.5" style="background:rgba(255,255,255,0.72);border-color:rgba(255,255,255,0.6);color:#6B63A3;">
                {guide.title}
              </a>
            ))}
          </div>
        </div>

        <div class="rounded-[2rem] border p-7" style="background:linear-gradient(135deg,#fffbeb,#fff7ed);border-color:#FCD34D;">
          <p class="text-xs font-bold uppercase tracking-[0.24em]" style="color:#d97706;">Market-specific</p>
          <h3 class="mt-3 text-2xl font-black" style="color:#1A1340;">Indian festive and family-event demand</h3>
          <div class="mt-5 space-y-3">
            {MARKET_CLUSTERS.map((cluster) => (
              <a href={`/indian/${cluster.slug}/`} class="block rounded-2xl border px-4 py-3 text-sm font-semibold transition-all hover:-translate-y-0.5" style="background:rgba(255,255,255,0.72);border-color:rgba(255,255,255,0.6);color:#6B63A3;">
                {cluster.title}
              </a>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-6 py-20" data-scroll="fade">
      <div
        class="relative overflow-hidden rounded-3xl px-8 py-16 text-center text-white"
        style="background:linear-gradient(135deg,#4F46E5 0%,#7C3AED 50%,#EC4899 100%);"
      >
        <div
          class="absolute inset-0 pointer-events-none opacity-10"
          style="background-image:radial-gradient(rgba(255,255,255,0.5) 1px,transparent 1px);background-size:28px 28px;"
        />
        <div class="relative">
          <h2 class="mb-3 text-4xl font-black tracking-tight lg:text-5xl">Ready to create?</h2>
          <p class="mx-auto mb-10 max-w-md text-lg opacity-80">
            Your card can be ready in under 60 seconds. No account needed.
          </p>
          <div class="flex flex-wrap justify-center gap-3">
            {OCCASIONS.slice(0, 6).map((occasion) => (
              <a
                href={`/make/${occasion.slug}/`}
                class="rounded-full px-5 py-2.5 text-sm font-bold transition-all hover:scale-105 active:scale-95"
                style="background:rgba(255,255,255,0.18);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,0.25);"
              >
                {occasion.emoji} {occasion.name}
              </a>
            ))}
            <a
              href="/drafts/"
              class="rounded-full px-5 py-2.5 text-sm font-bold transition-all hover:scale-105 active:scale-95"
              style="background:rgba(255,255,255,0.18);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,0.25);"
            >
              Resume Recent Project
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-3xl px-6 py-16 pb-24" data-scroll>
      <h2 class="mb-10 text-center text-3xl font-black tracking-tight" style="color:var(--color-text);">
        Frequently asked questions
      </h2>
      <div class="space-y-3">
        {[
          {
            q: `Is ${SITE.name} completely free?`,
            a: 'Yes. Every template and every download is free. No subscription, no watermark, and no credit card required.',
          },
          {
            q: 'Can I print the card or invitation?',
            a: 'Yes. The PNG download is high resolution and suitable for digital sharing and home printing.',
          },
          {
            q: 'How do I customize the text?',
            a: 'Type in the heading, message, and detail fields on the left. The preview updates instantly so you can see the final design as you edit.',
          },
          {
            q: 'What occasions are supported?',
            a: 'The library includes birthdays, weddings, baby showers, graduations, anniversaries, holidays, and many more celebration types.',
          },
          {
            q: 'Do I need an account or sign-up?',
            a: 'No. You can open the site, make your card, and download it without creating an account.',
          },
        ].map((faq) => (
          <details
            class="group rounded-2xl p-5 transition-all"
            style="background:var(--color-surface);border:1px solid var(--color-border);"
          >
            <summary
              class="flex list-none cursor-pointer items-center justify-between gap-4 font-semibold"
              style="color:var(--color-text);"
            >
              {faq.q}
              <svg
                class="shrink-0 transition-transform duration-200 group-open:rotate-180"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2.5"
              >
                <polyline points="6 9 12 15 18 9" />
              </svg>
            </summary>
            <p class="mt-3 text-sm leading-relaxed" style="color:var(--color-text-muted);">{faq.a}</p>
          </details>
        ))}
      </div>
    </section>
  </main>

  <Footer />
</Layout>
