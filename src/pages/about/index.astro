---
import Layout from '../../layouts/Layout.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import { OCCASIONS } from '../../lib/occasions';
import { SITE, absoluteUrl } from '../../lib/site';

const totalTemplates = OCCASIONS.reduce((sum, occasion) => sum + occasion.templates.length, 0);
---

<Layout
  title={`About ${SITE.name}`}
  description={`${SITE.name} is a free, no-signup invitation and greeting card maker. Create beautiful cards for any occasion and download high-resolution PNG instantly.`}
  canonical={absoluteUrl('/about/')}
>
  <Header />

  <main id="main-content">
    <section class="relative overflow-hidden py-24 lg:py-32" style="background:#0C0705;">
      <div class="absolute pointer-events-none" style="top:-20%;left:20%;width:600px;height:600px;border-radius:50%;background:radial-gradient(circle,rgba(234,88,12,0.15) 0%,transparent 60%);" />
      <div class="absolute pointer-events-none" style="bottom:-10%;right:10%;width:500px;height:500px;border-radius:50%;background:radial-gradient(circle,rgba(236,72,153,0.12) 0%,transparent 60%);" />
      <div class="absolute inset-0 pointer-events-none" style="background-image:linear-gradient(rgba(255,255,255,0.02) 1px,transparent 1px),linear-gradient(90deg,rgba(255,255,255,0.02) 1px,transparent 1px);background-size:80px 80px;" />
      <div class="relative mx-auto max-w-4xl px-6 text-center">
        <div class="mb-6 inline-flex items-center gap-2 rounded-full px-4 py-1.5 text-xs font-bold uppercase tracking-widest" style="background:rgba(234,88,12,0.1);border:1px solid rgba(234,88,12,0.2);color:#fb923c;">
          Our Mission
        </div>
        <h1 class="mb-6 font-black tracking-tight text-white" style="font-size:clamp(2.5rem,7vw,4.5rem);line-height:0.95;">
          Beautiful cards for
          <br />
          <span style="background:linear-gradient(135deg,#fb923c,#f472b6);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">
            every celebration
          </span>
        </h1>
        <p class="mx-auto max-w-2xl text-xl leading-relaxed" style="color:rgba(255,255,255,0.45);">
          {SITE.name} exists to make creating a beautiful invitation or greeting card instant, free, and enjoyable for everyone.
        </p>
      </div>
    </section>

    <section class="relative overflow-hidden py-16" style="background:var(--color-surface-2);">
      <div class="mx-auto max-w-6xl px-6">
        <div class="grid grid-cols-2 gap-8 text-center md:grid-cols-4" data-scroll="fade">
          {[
            [`${OCCASIONS.length}+`, 'Occasions'],
            [`${totalTemplates}+`, 'Templates'],
            ['100%', 'Free to use'],
            ['0', 'Required sign-ups'],
          ].map(([value, label]) => (
            <div>
              <div class="mb-1 font-black" style="font-size:2.5rem;line-height:1;background:linear-gradient(135deg,#ea580c,#ec4899);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">{value}</div>
              <div class="text-sm font-semibold" style="color:var(--color-text-muted);">{label}</div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <section class="mx-auto max-w-3xl px-6 py-20" data-scroll>
      <div class="space-y-8">
        <div class="rounded-2xl p-8" style="background:var(--color-surface);border:1px solid var(--color-border);">
          <h2 class="mb-4 text-2xl font-black" style="color:var(--color-text);">Why we built this</h2>
          <p class="leading-relaxed" style="color:var(--color-text-muted);">
            Creating an invitation should not require complex software, a paid subscription, or too much time. {SITE.name} is built to help people launch polished invitations and greeting cards in minutes.
          </p>
        </div>

        <div class="rounded-2xl p-8" style="background:var(--color-surface);border:1px solid var(--color-border);">
          <h2 class="mb-4 text-2xl font-black" style="color:var(--color-text);">What we offer</h2>
          <ul class="space-y-3">
            {[
              ['21+ occasions', 'From birthdays and weddings to Diwali, Eid, Halloween, and corporate events.'],
              ['100+ templates', 'A growing library of styles for different tones, seasons, and audiences.'],
              ['Real-time preview', 'Update your text and see your card design change immediately.'],
              ['High-resolution downloads', 'Export finished cards as PNG files for digital sharing or printing.'],
              ['No account required', 'Open the site, make your card, and download it directly.'],
            ].map(([title, description]) => (
              <li class="flex gap-4">
                <div class="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full" style="background:linear-gradient(135deg,#ea580c,#ec4899);">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="white" stroke-width="3"><polyline points="20 6 9 17 4 12" /></svg>
                </div>
                <div>
                  <span class="font-bold" style="color:var(--color-text);">{title}</span>
                  <span style="color:var(--color-text-muted);"> - {description}</span>
                </div>
              </li>
            ))}
          </ul>
        </div>

        <div class="rounded-2xl p-8" style="background:linear-gradient(135deg,rgba(234,88,12,0.05),rgba(236,72,153,0.05));border:1px solid rgba(234,88,12,0.15);">
          <h2 class="mb-4 text-2xl font-black" style="color:var(--color-text);">Privacy first</h2>
          <p class="leading-relaxed" style="color:var(--color-text-muted);">
            The editor is intended to work client-side so visitors can create personal invitations with as little friction and data collection as possible.
          </p>
        </div>
      </div>

      <div class="mt-14 text-center" data-scroll="fade">
        <h2 class="mb-4 text-2xl font-black" style="color:var(--color-text);">Get in touch</h2>
        <p class="mb-8" style="color:var(--color-text-muted);">Have a feature request, found a bug, or want to partner?</p>
        <div class="flex flex-col justify-center gap-4 sm:flex-row">
          <a
            href={`mailto:${SITE.email}`}
            class="rounded-2xl px-8 py-4 font-bold text-white transition-all hover:opacity-90"
            style="background:linear-gradient(135deg,#ea580c,#ec4899);"
          >
            {SITE.email}
          </a>
          <a
            href="/occasions/"
            class="rounded-2xl px-8 py-4 font-bold transition-all hover:opacity-80"
            style="background:var(--color-surface);border:1px solid var(--color-border);color:var(--color-text);"
          >
            Browse occasions
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer />
</Layout>
