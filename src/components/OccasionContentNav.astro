---
import type { Occasion } from '../lib/occasions';
import { getOccasionHubLinks } from '../lib/landing';

interface Props {
  occasion: Occasion;
  title?: string;
}

const { occasion, title = `Explore ${occasion.name} resources` } = Astro.props;
const links = getOccasionHubLinks(occasion);
---

<section class="mx-auto max-w-6xl px-6 py-10" data-scroll>
  <h2 class="mb-6 text-2xl font-black tracking-tight" style="color:var(--color-text);">{title}</h2>
  <div class="grid gap-4 md:grid-cols-3">
    {links.map((link) => (
      <a
        href={link.href}
        class="rounded-3xl border p-6 transition-all hover:-translate-y-1"
        style="background:var(--color-surface);border-color:var(--color-border);"
      >
        <h3 class="text-lg font-bold" style="color:var(--color-text);">{link.title}</h3>
        <p class="mt-2 text-sm leading-relaxed" style="color:var(--color-text-muted);">{link.description}</p>
      </a>
    ))}
  </div>
</section>
