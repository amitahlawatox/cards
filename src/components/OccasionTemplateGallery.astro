---
import type { Occasion } from '../lib/occasions';

interface Props {
  occasion: Occasion;
  heading?: string;
  intro?: string;
  limit?: number;
  showEditorCta?: boolean;
  linkMode?: 'editor' | 'detail';
}

const {
  occasion,
  heading = `${occasion.name} templates`,
  intro = `Browse editable ${occasion.name.toLowerCase()} styles and open the editor when you are ready to customize.`,
  limit = occasion.templates.length,
  showEditorCta = true,
  linkMode = 'editor',
} = Astro.props;

const templates = occasion.templates.slice(0, limit);
---

<section class="mx-auto max-w-7xl px-6 py-10" data-scroll>
  <div class="mb-7 flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <div>
      <h2 class="text-2xl font-black tracking-tight" style="color:var(--color-text);">{heading}</h2>
      <p class="mt-2 max-w-2xl text-sm leading-relaxed" style="color:var(--color-text-muted);">{intro}</p>
    </div>
    {showEditorCta && (
      <a
        href={`/make/${occasion.slug}/`}
        class="inline-flex items-center gap-2 rounded-full px-5 py-3 text-sm font-bold text-white transition-all hover:opacity-90"
        style="background:linear-gradient(135deg,#ea580c,#ec4899);"
      >
        Customize this occasion
      </a>
    )}
  </div>

  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 xl:grid-cols-6">
    {templates.map((template) => (
      <a
        href={`/make/${occasion.slug}/`}
        class="group occasion-card cursor-pointer overflow-hidden rounded-2xl"
        style={`border:1px solid var(--color-border);background:${template.bg};`}
        title={`${template.name} - ${occasion.name}`}
      >
        <div class="relative aspect-[3/4] min-h-[160px] p-4 text-center">
          {template.pattern && (
            <div class="absolute inset-0 pointer-events-none" style={`background-image:${template.pattern};background-size:24px 24px;opacity:0.7;`} />
          )}
          <div class="relative z-10 flex h-full flex-col items-center justify-center gap-2">
            <div style={`width:28px;height:2px;background:${template.accentColor};border-radius:2px;opacity:0.8;`} />
            <p class="max-w-[90%] text-xs font-bold leading-tight" style={`color:${template.textColor};font-size:10px;`}>
              {template.defaultHeading.length > 24 ? `${template.defaultHeading.slice(0, 21)}...` : template.defaultHeading}
            </p>
            <div style={`width:20px;height:1px;background:${template.accentColor};opacity:0.4;`} />
            <p style={`color:${template.textColor};font-size:8px;opacity:0.7;`}>
              {template.defaultBody.split('\n')[0].slice(0, 22)}
            </p>
          </div>
          <div
            class="absolute inset-0 flex items-center justify-center opacity-0 transition-opacity duration-200 group-hover:opacity-100"
            style="background:rgba(0,0,0,0.35);backdrop-filter:blur(2px);"
          >
            <span class="rounded-full px-3 py-1.5 text-xs font-bold text-white" style="background:rgba(234,88,12,0.9);">
              {linkMode === 'detail' ? 'Open editor' : 'Customize'}
            </span>
          </div>
        </div>
        <div class="border-t bg-white px-3 py-2.5" style="border-color:#E4E1FF;">
          <p class="truncate text-xs font-bold" style="color:#1A1340;">{template.name}</p>
          <p class="text-xs" style="color:#6B63A3;">{occasion.emoji} {occasion.name}</p>
        </div>
      </a>
    ))}
  </div>
</section>
