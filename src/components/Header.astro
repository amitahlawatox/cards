---
const pathname = Astro.url.pathname;
const isHome = pathname === '/';

const nav = [
  { label: 'Occasions',  href: '/occasions/' },
  { label: 'Templates',  href: '/templates/' },
  { label: 'About',      href: '/about/' },
];
---

<header id="site-header" class="fixed top-0 inset-x-0 z-50 transition-all duration-300">
  <div class="mx-auto max-w-7xl px-6 lg:px-8 h-16 flex items-center justify-between gap-4">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 shrink-0 group" aria-label="CardCraftly home">
      <div class="relative w-9 h-9 rounded-xl flex items-center justify-center shrink-0"
        style="background:linear-gradient(135deg,#4F46E5,#7C3AED);">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2" stroke="white" stroke-width="2"/>
          <line x1="3" y1="9.5" x2="21" y2="9.5" stroke="white" stroke-width="1.8"/>
          <rect x="6" y="13" width="4" height="1.5" rx="0.75" fill="white"/>
          <rect x="6" y="16" width="7" height="1.5" rx="0.75" fill="white"/>
        </svg>
      </div>
      <span id="logo-text" class="text-xl font-black tracking-tight transition-colors gradient-text-warm">
        CardCraftly
      </span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-1" aria-label="Primary">
      {nav.map(l => (
        <a
          href={l.href}
          class={`nav-link rounded-lg px-3.5 py-2 text-sm font-semibold transition-all ${pathname === l.href ? 'active' : ''}`}
        >
          {l.label}
        </a>
      ))}
    </nav>

    <!-- Right -->
    <div class="flex items-center gap-3">
      <!-- Theme toggle — no inline onclick, wired in script below -->
      <button id="theme-toggle-btn" aria-label="Toggle dark mode"
        class="theme-btn rounded-xl p-2.5 transition-all border border-transparent"
        style="color:rgba(255,255,255,0.6);">
        <!-- Moon shown in light mode -->
        <svg id="icon-moon" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
        <!-- Sun shown in dark mode, hidden by default -->
        <svg id="icon-sun" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="display:none;">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
      </button>
      <a
        href="/make/birthday/"
        class="hidden sm:flex items-center gap-1.5 px-5 py-2.5 rounded-xl text-sm font-bold text-white transition-all hover:opacity-90 active:scale-95"
        style="background:linear-gradient(135deg,#4F46E5,#7C3AED);box-shadow:0 4px 18px rgba(79,70,229,0.35);"
      >
        Make Free Card
      </a>

      <!-- Mobile menu button -->
      <button id="mobile-menu-btn" class="md:hidden rounded-xl p-2.5 transition-all" aria-label="Open menu" style="color:rgba(255,255,255,0.6);">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden" style="background:rgba(12,7,5,0.97);border-top:1px solid rgba(255,255,255,0.06);">
    <nav class="mx-auto max-w-7xl px-6 py-4 flex flex-col gap-1">
      {nav.map(l => (
        <a href={l.href} class="px-4 py-3 rounded-xl text-sm font-semibold transition-all" style="color:rgba(255,255,255,0.7);">{l.label}</a>
      ))}
      <a href="/make/birthday/" class="mt-2 px-4 py-3 rounded-xl text-sm font-bold text-white text-center" style="background:linear-gradient(135deg,#4F46E5,#7C3AED);">
        Make Free Card
      </a>
    </nav>
  </div>
</header>

<!-- Spacer so fixed header doesn't cover content (only for non-home pages) -->
{!isHome && <div class="h-16" aria-hidden="true" />}

<script is:inline>
(function () {
  var header   = document.getElementById('site-header');
  var navLinks = document.querySelectorAll('.nav-link');
  var themeBtn = document.getElementById('theme-toggle-btn');
  var iconMoon = document.getElementById('icon-moon');
  var iconSun  = document.getElementById('icon-sun');
  var isHome   = document.body.dataset.homepage === 'true';

  function dark() { return document.documentElement.classList.contains('dark'); }

  /* Update the moon/sun icon to match current state */
  function syncIcon() {
    if (!iconMoon || !iconSun) return;
    iconMoon.style.display = dark() ? 'none'  : 'block';
    iconSun.style.display  = dark() ? 'block' : 'none';
  }

  function applyOverHero() {
    /* Over the hero: always white text, but slightly different bg to signal light vs dark */
    header.style.background    = dark() ? 'rgba(6,4,20,0.88)'  : 'rgba(13,10,36,0.72)';
    header.style.borderBottom  = '1px solid rgba(255,255,255,0.07)';
    header.style.boxShadow     = 'none';
    header.style.backdropFilter= 'blur(14px)';
    navLinks.forEach(function(l) {
      l.style.color = l.classList.contains('active') ? '#a5b4fc' : 'rgba(255,255,255,0.6)';
    });
    if (themeBtn) {
      themeBtn.style.color            = 'rgba(255,255,255,0.7)';
      themeBtn.style.background       = dark() ? 'rgba(255,255,255,0.08)' : 'rgba(255,255,255,0.06)';
      themeBtn.style.border           = dark() ? '1px solid rgba(255,255,255,0.15)' : '1px solid rgba(255,255,255,0.1)';
    }
  }

  function applyLight() {
    header.style.background    = 'rgba(250,250,254,0.95)';
    header.style.borderBottom  = '1px solid rgba(228,225,255,1)';
    header.style.boxShadow     = '0 1px 20px rgba(79,70,229,0.08)';
    header.style.backdropFilter= 'blur(16px)';
    navLinks.forEach(function(l) {
      l.style.color = l.classList.contains('active') ? '#4F46E5' : '#6B63A3';
    });
    if (themeBtn) {
      themeBtn.style.color      = '#6B63A3';
      themeBtn.style.background = 'transparent';
      themeBtn.style.border     = '1px solid transparent';
    }
  }

  function applyDark() {
    header.style.background    = 'rgba(6,4,20,0.93)';
    header.style.borderBottom  = '1px solid rgba(42,32,80,1)';
    header.style.boxShadow     = '0 1px 20px rgba(0,0,0,0.25)';
    header.style.backdropFilter= 'blur(16px)';
    navLinks.forEach(function(l) {
      l.style.color = l.classList.contains('active') ? '#818cf8' : '#9B8FD4';
    });
    if (themeBtn) {
      themeBtn.style.color      = '#9B8FD4';
      themeBtn.style.background = 'transparent';
      themeBtn.style.border     = '1px solid transparent';
    }
  }

  function update() {
    var overHero = isHome && window.scrollY < window.innerHeight * 0.75;
    syncIcon();
    if (overHero)      { applyOverHero(); }
    else if (dark())   { applyDark();     }
    else               { applyLight();    }
  }

  window.addEventListener('scroll', update, { passive: true });

  /* Wire toggle button via addEventListener — more reliable than onclick attr */
  if (themeBtn) {
    themeBtn.addEventListener('click', function() {
      if (typeof window.__toggleTheme === 'function') {
        window.__toggleTheme();
      }
    });
  }

  /* Called by __toggleTheme after toggling the dark class */
  window.__onThemeChange = function() { update(); };

  update();

  /* Mobile menu */
  var mBtn = document.getElementById('mobile-menu-btn');
  var menu = document.getElementById('mobile-menu');
  if (mBtn && menu) {
    mBtn.addEventListener('click', function() { menu.classList.toggle('hidden'); });
  }
})();
</script>
