---
const pathname = Astro.url.pathname;
---
<header class="sticky top-0 z-40 w-full" style="background:rgba(255,251,247,0.92);border-bottom:1px solid var(--color-border);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);">
  <style>
    .dark header-inner { background: rgba(20,10,0,0.92) !important; }
  </style>
  <div class="mx-auto flex max-w-6xl items-center justify-between px-4 py-3 sm:px-6">

    <!-- Logo -->
    <a href="/" class="group flex items-center gap-2.5" aria-label="CardCraftly home">
      <div class="relative flex h-9 w-9 items-center justify-center rounded-xl"
        style="background:linear-gradient(135deg,#e8420a,#ec4899,#f97316);">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2" stroke="white" stroke-width="2"/>
          <line x1="3" y1="9.5" x2="21" y2="9.5" stroke="white" stroke-width="1.8"/>
          <rect x="6" y="13" width="4" height="1.5" rx="0.75" fill="white"/>
          <rect x="6" y="16" width="7" height="1.5" rx="0.75" fill="white"/>
        </svg>
      </div>
      <span class="text-xl font-black tracking-tight gradient-text-warm">CardCraftly</span>
    </a>

    <!-- Desktop nav -->
    <nav class="hidden items-center gap-1 md:flex" aria-label="Main navigation">
      {[
        { label: 'Home',           href: '/' },
        { label: 'All Occasions',  href: '/occasions/' },
        { label: 'Birthday',       href: '/make/birthday/' },
        { label: 'Wedding',        href: '/make/wedding/' },
      ].map(l => (
        <a href={l.href}
          class="rounded-lg px-3.5 py-2 text-sm font-semibold transition-all"
          style={pathname === l.href
            ? 'color:#e8420a;background:rgba(232,66,10,0.08);'
            : 'color:var(--color-text-muted);'}>
          {l.label}
        </a>
      ))}
    </nav>

    <!-- Right -->
    <div class="flex items-center gap-2">
      <button onclick="window.__toggleTheme()" aria-label="Toggle dark mode"
        class="rounded-xl p-2.5 transition-all hover:bg-orange-50 dark:hover:bg-orange-900/20"
        style="color:var(--color-text-muted);">
        <svg class="hidden dark:block" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
        <svg class="dark:hidden" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
      </button>
      <a href="/occasions/"
        class="hidden sm:flex items-center gap-1.5 rounded-xl px-4 py-2 text-sm font-bold text-white transition-all hover:opacity-90 active:scale-95"
        style="background:linear-gradient(135deg,#e8420a,#ec4899);box-shadow:0 4px 16px rgba(232,66,10,0.3);">
        🎉 Make Free Card
      </a>
    </div>
  </div>
</header>
