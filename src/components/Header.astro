---
const pathname = Astro.url.pathname;
const isHome = pathname === '/';

const nav = [
  { label: 'Occasions',  href: '/occasions/' },
  { label: 'Templates',  href: '/templates/' },
  { label: 'About',      href: '/about/' },
];
---

<header id="site-header" class="fixed top-0 inset-x-0 z-50 transition-all duration-300">
  <div class="mx-auto max-w-7xl px-6 lg:px-8 h-16 flex items-center justify-between gap-4">

    <!-- Logo -->
    <a href="/" class="flex items-center gap-2.5 shrink-0 group" aria-label="CardCraftly home">
      <div class="relative w-9 h-9 rounded-xl flex items-center justify-center shrink-0"
        style="background:linear-gradient(135deg,#ea580c,#ec4899);">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2" stroke="white" stroke-width="2"/>
          <line x1="3" y1="9.5" x2="21" y2="9.5" stroke="white" stroke-width="1.8"/>
          <rect x="6" y="13" width="4" height="1.5" rx="0.75" fill="white"/>
          <rect x="6" y="16" width="7" height="1.5" rx="0.75" fill="white"/>
        </svg>
      </div>
      <span id="logo-text" class="text-xl font-black tracking-tight transition-colors gradient-text-warm">
        CardCraftly
      </span>
    </a>

    <!-- Desktop Nav -->
    <nav class="hidden md:flex items-center gap-1" aria-label="Primary">
      {nav.map(l => (
        <a
          href={l.href}
          class={`nav-link rounded-lg px-3.5 py-2 text-sm font-semibold transition-all ${pathname === l.href ? 'active' : ''}`}
        >
          {l.label}
        </a>
      ))}
    </nav>

    <!-- Right -->
    <div class="flex items-center gap-3">
      <button onclick="window.__toggleTheme()" aria-label="Toggle dark mode"
        class="theme-btn rounded-xl p-2.5 transition-all"
        style="color:rgba(255,255,255,0.5);">
        <!-- Moon (light mode) -->
        <svg class="dark:hidden" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
        </svg>
        <!-- Sun (dark mode) -->
        <svg class="hidden dark:block" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="5"/>
          <line x1="12" y1="1" x2="12" y2="3"/><line x1="12" y1="21" x2="12" y2="23"/>
          <line x1="4.22" y1="4.22" x2="5.64" y2="5.64"/><line x1="18.36" y1="18.36" x2="19.78" y2="19.78"/>
          <line x1="1" y1="12" x2="3" y2="12"/><line x1="21" y1="12" x2="23" y2="12"/>
          <line x1="4.22" y1="19.78" x2="5.64" y2="18.36"/><line x1="18.36" y1="5.64" x2="19.78" y2="4.22"/>
        </svg>
      </button>
      <a
        href="/make/birthday/"
        class="hidden sm:flex items-center gap-1.5 px-5 py-2.5 rounded-xl text-sm font-bold text-white transition-all hover:opacity-90 active:scale-95"
        style="background:linear-gradient(135deg,#ea580c,#ec4899);box-shadow:0 4px 18px rgba(234,88,12,0.35);"
      >
        Make Free Card
      </a>

      <!-- Mobile menu button -->
      <button id="mobile-menu-btn" class="md:hidden rounded-xl p-2.5 transition-all" aria-label="Open menu" style="color:rgba(255,255,255,0.6);">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/>
        </svg>
      </button>
    </div>
  </div>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden md:hidden" style="background:rgba(12,7,5,0.97);border-top:1px solid rgba(255,255,255,0.06);">
    <nav class="mx-auto max-w-7xl px-6 py-4 flex flex-col gap-1">
      {nav.map(l => (
        <a href={l.href} class="px-4 py-3 rounded-xl text-sm font-semibold transition-all" style="color:rgba(255,255,255,0.7);">{l.label}</a>
      ))}
      <a href="/make/birthday/" class="mt-2 px-4 py-3 rounded-xl text-sm font-bold text-white text-center" style="background:linear-gradient(135deg,#ea580c,#ec4899);">
        Make Free Card
      </a>
    </nav>
  </div>
</header>

<!-- Spacer so fixed header doesn't cover content (only for non-home pages) -->
{!isHome && <div class="h-16" aria-hidden="true" />}

<script is:inline>
(function () {
  var header = document.getElementById('site-header');
  var navLinks = document.querySelectorAll('.nav-link');
  var themeBtn = document.querySelector('.theme-btn');
  var isHome = document.body.dataset.homepage === 'true';
  var scrolled = false;

  function setDark() {
    header.style.background = 'rgba(12,7,5,0.82)';
    header.style.borderBottom = '1px solid rgba(255,255,255,0.055)';
    header.style.boxShadow = 'none';
    navLinks.forEach(function(l) {
      if (!l.classList.contains('active')) l.style.color = 'rgba(255,255,255,0.58)';
      else l.style.color = '#fb923c';
    });
    if (themeBtn) themeBtn.style.color = 'rgba(255,255,255,0.5)';
  }

  function setLight() {
    header.style.background = 'rgba(255,251,247,0.94)';
    header.style.borderBottom = '1px solid rgba(240,228,212,1)';
    header.style.boxShadow = '0 1px 20px rgba(0,0,0,0.07)';
    navLinks.forEach(function(l) {
      if (!l.classList.contains('active')) l.style.color = '#8a5c3c';
      else l.style.color = '#ea580c';
    });
    if (themeBtn) themeBtn.style.color = '#8a5c3c';
  }

  function update() {
    var shouldBeLight = !isHome || window.scrollY > window.innerHeight * 0.8;
    if (shouldBeLight) setLight(); else setDark();
  }

  window.addEventListener('scroll', update, { passive: true });
  update();

  // Mobile menu toggle
  var btn = document.getElementById('mobile-menu-btn');
  var menu = document.getElementById('mobile-menu');
  if (btn && menu) {
    btn.addEventListener('click', function() {
      menu.classList.toggle('hidden');
    });
  }

  // Apply dark header immediately on homepage
  if (isHome) setDark();
})();
</script>
