---
import { SITE } from '../lib/site';

const pathname = Astro.url.pathname;
const isHome = pathname === '/';

const nav = [
  { label: 'Occasions', href: '/occasions/' },
  { label: 'Templates', href: '/templates/' },
  { label: 'Features', href: '/features/' },
  { label: 'Guides', href: '/guides/' },
  { label: 'Wording', href: '/wording/' },
];
---

<header id="site-header" class="fixed inset-x-0 top-0 z-50 transition-all duration-300">
  <div class="mx-auto flex h-16 max-w-7xl items-center justify-between gap-4 px-6 lg:px-8">
    <a href="/" class="flex shrink-0 items-center gap-2.5 group" aria-label={`${SITE.name} home`}>
      <div
        class="relative flex h-9 w-9 shrink-0 items-center justify-center rounded-xl"
        style="background:linear-gradient(135deg,#4F46E5,#7C3AED);"
      >
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
          <rect x="3" y="5" width="18" height="14" rx="2" stroke="white" stroke-width="2" />
          <line x1="3" y1="9.5" x2="21" y2="9.5" stroke="white" stroke-width="1.8" />
          <rect x="6" y="13" width="4" height="1.5" rx="0.75" fill="white" />
          <rect x="6" y="16" width="7" height="1.5" rx="0.75" fill="white" />
        </svg>
      </div>
      <span id="logo-text" class="gradient-text-warm text-xl font-black tracking-tight transition-colors">
        {SITE.name}
      </span>
    </a>

    <nav class="hidden items-center gap-1 md:flex" aria-label="Primary">
      {nav.map((link) => (
        <a
          href={link.href}
          class={`nav-link rounded-lg px-3.5 py-2 text-sm font-semibold transition-all ${pathname === link.href ? 'active' : ''}`}
        >
          {link.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="/drafts/"
        class="hidden items-center rounded-xl px-4 py-2.5 text-sm font-bold transition-all hover:opacity-90 sm:flex"
        style="background:rgba(79,70,229,0.08);color:#4F46E5;border:1px solid rgba(79,70,229,0.18);"
      >
        Recent Projects
      </a>
      <a
        href="/make/birthday/"
        class="hidden items-center gap-1.5 rounded-xl px-5 py-2.5 text-sm font-bold text-white transition-all hover:opacity-90 active:scale-95 sm:flex"
        style="background:linear-gradient(135deg,#4F46E5,#7C3AED);box-shadow:0 4px 18px rgba(79,70,229,0.35);"
      >
        Make Free Card
      </a>

      <button
        id="mobile-menu-btn"
        class="flex min-h-11 min-w-11 items-center justify-center rounded-xl p-2.5 transition-all md:hidden"
        aria-label="Open menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
        style="color:rgba(255,255,255,0.6);"
      >
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="3" y1="6" x2="21" y2="6" />
          <line x1="3" y1="12" x2="21" y2="12" />
          <line x1="3" y1="18" x2="21" y2="18" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-menu" class="hidden md:hidden" style="background:rgba(12,7,5,0.97);border-top:1px solid rgba(255,255,255,0.06);">
    <nav class="mx-auto flex max-w-7xl flex-col gap-1 px-6 py-4" aria-label="Mobile primary">
      {nav.map((link) => (
        <a href={link.href} class="rounded-xl px-4 py-3 text-sm font-semibold transition-all" style="color:rgba(255,255,255,0.7);">
          {link.label}
        </a>
      ))}
      <a href="/drafts/" class="rounded-xl px-4 py-3 text-sm font-semibold transition-all" style="color:rgba(255,255,255,0.7);">
        Recent Projects
      </a>
      <a href="/make/birthday/" class="mt-2 rounded-xl px-4 py-3 text-center text-sm font-bold text-white" style="background:linear-gradient(135deg,#4F46E5,#7C3AED);">
        Make Free Card
      </a>
    </nav>
  </div>
</header>

{!isHome && <div class="h-16" aria-hidden="true" />}

<script is:inline>
  (function () {
    var header = document.getElementById('site-header');
    var navLinks = document.querySelectorAll('.nav-link');
    var isHome = document.body.dataset.homepage === 'true';

    function applyOverHero() {
      header.style.background = 'rgba(13,10,36,0.72)';
      header.style.borderBottom = '1px solid rgba(255,255,255,0.07)';
      header.style.boxShadow = 'none';
      header.style.backdropFilter = 'blur(14px)';
      navLinks.forEach(function (link) {
        link.style.color = link.classList.contains('active') ? '#a5b4fc' : 'rgba(255,255,255,0.6)';
      });
    }

    function applyLight() {
      header.style.background = 'rgba(250,250,254,0.95)';
      header.style.borderBottom = '1px solid rgba(228,225,255,1)';
      header.style.boxShadow = '0 1px 20px rgba(79,70,229,0.08)';
      header.style.backdropFilter = 'blur(16px)';
      navLinks.forEach(function (link) {
        link.style.color = link.classList.contains('active') ? '#4F46E5' : '#6B63A3';
      });
    }

    function update() {
      var overHero = isHome && window.scrollY < window.innerHeight * 0.75;
      if (overHero) applyOverHero();
      else applyLight();
    }

    window.addEventListener('scroll', update, { passive: true });
    update();

    var menuButton = document.getElementById('mobile-menu-btn');
    var menu = document.getElementById('mobile-menu');
    if (menuButton && menu) {
      function setMenuOpen(open) {
        menu.classList.toggle('hidden', !open);
        menuButton.setAttribute('aria-expanded', String(open));
        menuButton.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
        if (open) {
          var firstLink = menu.querySelector('a');
          if (firstLink) firstLink.focus();
        }
      }
      menuButton.addEventListener('click', function () {
        setMenuOpen(menu.classList.contains('hidden'));
      });
      menu.addEventListener('click', function (event) {
        if (event.target.closest('a')) setMenuOpen(false);
      });
      document.addEventListener('keydown', function (event) {
        if (event.key === 'Escape' && !menu.classList.contains('hidden')) {
          setMenuOpen(false);
          menuButton.focus();
        }
      });
    }
  })();
</script>
