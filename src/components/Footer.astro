---
import { OCCASIONS } from '../lib/occasions';
const year = new Date().getFullYear();
const topOccasions = OCCASIONS.slice(0, 8);
---
<footer class="border-t border-[var(--color-border)] bg-[var(--color-surface)] mt-16">
  <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <div class="mb-10 flex flex-col sm:flex-row sm:items-start sm:justify-between gap-6">
      <div class="max-w-xs">
        <a href="/" class="inline-flex items-center gap-2.5 group">
          <svg width="30" height="30" viewBox="0 0 32 32" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
            <defs>
              <radialGradient id="fcbg" cx="30%" cy="25%" r="80%">
                <stop offset="0%"   stop-color="#fb7185"/>
                <stop offset="50%"  stop-color="#ec4899"/>
                <stop offset="100%" stop-color="#be185d"/>
              </radialGradient>
              <clipPath id="fcrc"><rect width="32" height="32" rx="7.5"/></clipPath>
            </defs>
            <g clip-path="url(#fcrc)">
              <rect width="32" height="32" fill="url(#fcbg)"/>
              <rect x="7" y="9" width="18" height="14" rx="2" fill="none" stroke="white" stroke-width="2"/>
              <line x1="7" y1="13.5" x2="25" y2="13.5" stroke="white" stroke-width="1.8"/>
              <rect x="10" y="17" width="5" height="1.5" rx="0.75" fill="white"/>
              <rect x="10" y="20" width="8" height="1.5" rx="0.75" fill="white"/>
            </g>
          </svg>
          <span class="text-lg font-black bg-gradient-to-r from-pink-600 to-orange-500 bg-clip-text text-transparent">CardCraftly</span>
        </a>
        <p class="mt-2 text-sm text-[var(--color-text-muted)] leading-relaxed">
          Free invitation & greeting card maker. 12+ occasions. Customize text, download PNG. No sign-up, no watermark.
        </p>
        <div class="mt-3 flex gap-2 flex-wrap">
          <span class="inline-flex items-center gap-1 rounded-full border border-green-200/50 bg-green-50/50 px-3 py-1 text-xs font-medium text-green-700 dark:border-green-800/50 dark:bg-green-900/20 dark:text-green-400">✓ 100% Free</span>
          <span class="inline-flex items-center gap-1 rounded-full border border-pink-200/50 bg-pink-50/50 px-3 py-1 text-xs font-medium text-pink-700 dark:border-pink-800/50 dark:bg-pink-900/20 dark:text-pink-400">✓ No Watermark</span>
          <span class="inline-flex items-center gap-1 rounded-full border border-orange-200/50 bg-orange-50/50 px-3 py-1 text-xs font-medium text-orange-700 dark:border-orange-800/50 dark:bg-orange-900/20 dark:text-orange-400">⚡ Instant</span>
        </div>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
      <div>
        <h3 class="mb-4 text-xs font-bold uppercase tracking-widest text-[var(--color-text)]">Occasions</h3>
        <ul class="space-y-2">
          {topOccasions.map(o => (
            <li><a href={`/make/${o.slug}/`} class="text-sm text-[var(--color-text-muted)] hover:text-pink-600 transition-colors">{o.emoji} {o.name}</a></li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="mb-4 text-xs font-bold uppercase tracking-widest text-[var(--color-text)]">Tools</h3>
        <ul class="space-y-2">
          <li><a href="/make/birthday/" class="text-sm text-[var(--color-text-muted)] hover:text-pink-600 transition-colors">Birthday Card Maker</a></li>
          <li><a href="/make/wedding/" class="text-sm text-[var(--color-text-muted)] hover:text-pink-600 transition-colors">Wedding Invitation Maker</a></li>
          <li><a href="/make/baby-shower/" class="text-sm text-[var(--color-text-muted)] hover:text-pink-600 transition-colors">Baby Shower Invitations</a></li>
          <li><a href="/make/graduation/" class="text-sm text-[var(--color-text-muted)] hover:text-pink-600 transition-colors">Graduation Invitations</a></li>
          <li><a href="/occasions/" class="text-sm font-semibold text-pink-500 hover:text-pink-400 transition-colors">All Occasions →</a></li>
        </ul>
      </div>
      <div>
        <h3 class="mb-4 text-xs font-bold uppercase tracking-widest text-[var(--color-text)]">Company</h3>
        <ul class="space-y-2">
          <li><a href="/about/" class="text-sm text-[var(--color-text-muted)] hover:text-pink-600 transition-colors">About</a></li>
          <li><a href="/privacy/" class="text-sm text-[var(--color-text-muted)] hover:text-pink-600 transition-colors">Privacy Policy</a></li>
          <li><a href="/terms/" class="text-sm text-[var(--color-text-muted)] hover:text-pink-600 transition-colors">Terms of Service</a></li>
        </ul>
        <div class="mt-5">
          <h3 class="mb-2 text-xs font-bold uppercase tracking-widest text-[var(--color-text)]">Contact</h3>
          <a href="mailto:contact@cardcraftly.com" class="text-sm text-[var(--color-text-muted)] hover:text-pink-600 transition-colors">contact@cardcraftly.com</a>
        </div>
      </div>
    </div>

    <div class="mt-10 flex flex-col sm:flex-row items-center justify-between gap-3 border-t border-[var(--color-border)] pt-6 text-xs text-[var(--color-text-muted)]">
      <p>&copy; {year} CardCraftly. All rights reserved.</p>
      <p>Made with ❤️ for every celebration, big and small.</p>
    </div>
  </div>
</footer>
